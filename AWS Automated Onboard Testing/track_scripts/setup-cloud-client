#!/bin/bash
set -exo

echo "===== MAGIC LINK + ACCOUNT SETUP START ====="
date

# ---------------------------------------
# Ensure required tools are present and updated
# ---------------------------------------

apt-get update -y
apt-get install --only-upgrade -y curl git

# ---------------------------------------
# Sanitize AUTOACCOUNT_* values
# ---------------------------------------
# Instruqt's autoaccount custom resource emits these as JSON-array-literal
# strings (e.g. '["value"]') even with account_count: 1, not bare scalars.
for var in AUTOACCOUNT_TENANT_ID AUTOACCOUNT_APIKEY_ID AUTOACCOUNT_APIKEY_SECRET \
           AUTOACCOUNT_ORG_ID AUTOACCOUNT_PCE_FQDN AUTOACCOUNT_SAAPIKEY_KEYID \
           AUTOACCOUNT_SAAPIKEY_SECRET; do
  cleaned="$(echo "${!var}" | tr -d '{}[]"')"
  export "$var=$cleaned"
done

# Also make the cleaned values visible to any new terminal tab the
# learner opens - the container's own injected env vars are still the
# raw/dirty ones, so override them for every future interactive shell
# via .bashrc.
{
  for var in AUTOACCOUNT_TENANT_ID AUTOACCOUNT_APIKEY_ID AUTOACCOUNT_APIKEY_SECRET \
             AUTOACCOUNT_ORG_ID AUTOACCOUNT_PCE_FQDN AUTOACCOUNT_SAAPIKEY_KEYID \
             AUTOACCOUNT_SAAPIKEY_SECRET; do
    printf 'export %s=%q\n' "$var" "${!var}"
  done
} >> /root/.bashrc

# ---------------------------------------
# Parse PCE FQDN
# ---------------------------------------
if [[ "$AUTOACCOUNT_PCE_FQDN" == *:* ]]; then
  pceFqdn=${AUTOACCOUNT_PCE_FQDN%%:*}
  pcePort=${AUTOACCOUNT_PCE_FQDN##*:}
else
  echo "ERROR: AUTOACCOUNT_PCE_FQDN does not contain a port."
  exit 1
fi

# ---------------------------------------
# Save variables for later use (Instruqt state)
# ---------------------------------------
agent variable set ACCOUNTID "$AUTOACCOUNT_TENANT_ID"
agent variable set APINAME "api_${AUTOACCOUNT_APIKEY_ID}"
agent variable set APISECRET "$AUTOACCOUNT_APIKEY_SECRET"
agent variable set ORGID "$AUTOACCOUNT_ORG_ID"
agent variable set PCEFQDN "$pceFqdn"
agent variable set PCEPort "$pcePort"
agent variable set SACLIENT "$AUTOACCOUNT_SAAPIKEY_KEYID"
agent variable set SASECRET "$AUTOACCOUNT_SAAPIKEY_SECRET"

# ---------------------------------------
# MAGIC LINK SETUP
# ---------------------------------------
MAGIC_LINK=$(echo "${AUTOACCOUNT_MAGICLINK}" | tr -d '{}[]"')

echo "Generated MAGIC LINK:"
echo "$MAGIC_LINK"

agent variable set MAGICURL "$MAGIC_LINK"

git clone https://github.com/jdschmitz15/illumio-instruqt-terraform-template.git
AUTOACCOUNT_MAGICLINK="$MAGIC_LINK"
gomplate -f ~/illumio-instruqt-terraform-template/index.html.tmpl -o /var/www/html/index.html
date

# ---------------------------------------
# SELF-CHECK SCRIPT
# ---------------------------------------
cat > /usr/local/bin/check-cloud << 'CHECKEOF'
#!/bin/bash
clear
AUTH2="${AUTOACCOUNT_SAAPIKEY_KEYID}:${AUTOACCOUNT_SAAPIKEY_SECRET}"
curl -s -u "$AUTH2" -H "X-Tenant-Id: $AUTOACCOUNT_TENANT_ID" "https://cloud.illum.io/api/v1/integrations" | python3 -c "
import json, sys
d = json.load(sys.stdin)
aws = d.get('aws', [])
if not aws:
    print('FAIL - no AWS account onboarded yet')
else:
    a = aws[0]
    print('PASS - AWS account onboarded: ' + str(a.get('name')) + ' (status: ' + str(a.get('status')) + ', security review: ' + str(a.get('srStatus')) + ')')
"
CHECKEOF
chmod +x /usr/local/bin/check-cloud

# ---------------------------------------
# AWS BUILD (Terraform) + AUTOMATED ONBOARDING - runs in background,
# no vensim, no VMs. Prototype for whether onboarding can be triggered
# without a learner ever touching the Cloud -> Onboarding wizard.
# ---------------------------------------
nohup bash -c "
  set -ex
  export AWS_REGION=us-east-1
  export AWS_DEFAULT_REGION=us-east-1

  # Defensive re-clean: AUTOACCOUNT_SAAPIKEY_KEYID/SECRET/TENANT_ID can
  # arrive in THIS subshell still JSON-array-wrapped (e.g. literal
  # [\"value\"]) despite being cleaned earlier in the parent script -
  # live-observed 2026-09-03, caused oauth2 invalid_client on every
  # attempt because the wrapped value never matches a real credential.
  # Don't trust inheritance across the nohup bash -c boundary - re-clean
  # locally, right before use, regardless of what caused the corruption.
  AUTOACCOUNT_SAAPIKEY_KEYID=\$(echo \"\$AUTOACCOUNT_SAAPIKEY_KEYID\" | tr -d '{}[]\"')
  AUTOACCOUNT_SAAPIKEY_SECRET=\$(echo \"\$AUTOACCOUNT_SAAPIKEY_SECRET\" | tr -d '{}[]\"')
  AUTOACCOUNT_TENANT_ID=\$(echo \"\$AUTOACCOUNT_TENANT_ID\" | tr -d '{}[]\"')

  cd /root
  git clone https://github.com/Illumio-Training-Org/26x-course.git
  cd /root/26x-course/terraform

  # Install Terraform
  curl -fsSL https://apt.releases.hashicorp.com/gpg | gpg --yes --dearmor -o /usr/share/keyrings/hashicorp-archive-keyring.gpg
  echo \"deb [signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com \$(lsb_release -cs) main\" > /etc/apt/sources.list.d/hashicorp.list
  apt-get update -o Dir::Etc::sourcelist=\"sources.list.d/hashicorp.list\" -o Dir::Etc::sourceparts=\"-\" -o APT::Get::List-Cleanup=\"0\"
  apt-get install -y terraform

  terraform init -input=false
  terraform plan -out=tfplan -input=false
  terraform apply -input=false -auto-approve tfplan

  echo '### TERRAFORM APPLY COMPLETE ###'
  date

  # -----------------------------------------------------------------
  # AUTOMATED ILLUMIO CLOUD ONBOARDING - separate, isolated Terraform
  # config (not the shared terraform/ folder, so this experiment can't
  # break Course Lab or any exam track). Uses the official
  # illumio/illumio-cloudsecure Terraform provider, modeled on a
  # colleague's working example (Instruqt track grsxrhaf37xt).
  # -----------------------------------------------------------------
  echo '### STARTING AUTOMATED CLOUDSECURE ONBOARDING ###'
  date
  cd /root/26x-course/terraform-cloudsecure-aws

  # The SAAPIKEY credentials are minted by Instruqt's magic-link custom
  # resource at sandbox boot - live-observed 2026-09-03 that Illumio's
  # OAuth token endpoint can reject a freshly-minted key with
  # 'invalid_client' for a short window before it's fully active on
  # Illumio's side (the exact same credentials worked seconds later via
  # a direct curl test). Wait for the token endpoint to actually accept
  # them before handing them to terraform, instead of racing it.
  echo '### WAITING FOR CLOUDSECURE CREDENTIALS TO ACTIVATE ###'
  date
  cloudsecure_ready=0
  for attempt in \$(seq 1 30); do
    http_code=\$(curl -s -o /dev/null -w '%{http_code}' -X POST \"https://cloud.illum.io/api/v1/authenticate\" \
      -H \"Content-Type: application/x-www-form-urlencoded\" \
      --data-urlencode \"grant_type=client_credentials\" \
      --data-urlencode \"client_id=\$AUTOACCOUNT_SAAPIKEY_KEYID\" \
      --data-urlencode \"client_secret=\$AUTOACCOUNT_SAAPIKEY_SECRET\")
    if [ \"\$http_code\" = \"200\" ]; then
      echo \"CloudSecure credentials active after \$attempt attempt(s)\"
      cloudsecure_ready=1
      break
    fi
    echo \"Attempt \$attempt: token endpoint returned \$http_code, retrying in 10s...\"
    sleep 10
  done
  if [ \"\$cloudsecure_ready\" != \"1\" ]; then
    echo '### CLOUDSECURE CREDENTIALS NEVER ACTIVATED - ABORTING ONBOARDING ###'
    date
    exit 1
  fi
  date

  terraform init -input=false
  terraform plan -out=tfplan -input=false \
    -var \"illumio_cloudsecure_client_id=\$AUTOACCOUNT_SAAPIKEY_KEYID\" \
    -var \"illumio_cloudsecure_client_secret=\$AUTOACCOUNT_SAAPIKEY_SECRET\"
  terraform apply -input=false -auto-approve tfplan

  echo '### AUTOMATED CLOUDSECURE ONBOARDING APPLY COMPLETE ###'
  date

  # -----------------------------------------------------------------
  # REGISTER CLOUD CREDENTIALS - live-verified 2026-09-03 that the
  # illumio-cloudsecure_aws_account resource above is NOT enough on its
  # own: the account shows status ONBOARDING_COMPLETE, but roleArn stays
  # empty and inventory never populates, because the real Console wizard
  # relies on a CloudFormation stack whose Lambda makes a SEPARATE REST
  # call to activate the role for CloudSecure to actually assume. This
  # replays that exact same call (confirmed against the real CFT
  # downloaded from the Console's 'Add AWS Cloud Organization' wizard),
  # using the same SAAPIKEY Basic auth already used for every other
  # CloudSecure REST call in this project.
  # -----------------------------------------------------------------
  echo '### REGISTERING CLOUD CREDENTIALS WITH CLOUDSECURE ###'
  date
  ROLE_ARN=\$(terraform output -raw role_arn)
  ROLE_EXTERNAL_ID=\$(terraform output -raw role_external_id)
  AWS_ACCT_ID=\$(terraform output -raw aws_account_id)
  curl -sf -X POST \"https://cloud.illum.io/api/v1/integrations/cloud_credentials\" \
    -u \"\$AUTOACCOUNT_SAAPIKEY_KEYID:\$AUTOACCOUNT_SAAPIKEY_SECRET\" \
    -H \"X-Tenant-Id: \$AUTOACCOUNT_TENANT_ID\" \
    -H \"Content-Type: application/json\" \
    -d \"{\\\"account_id\\\":\\\"\$AWS_ACCT_ID\\\",\\\"role_arn\\\":\\\"\$ROLE_ARN\\\",\\\"external_id\\\":\\\"\$ROLE_EXTERNAL_ID\\\",\\\"type\\\":\\\"AWSRole\\\"}\"
  echo '### CLOUD CREDENTIALS REGISTRATION COMPLETE ###'
  date

  # -----------------------------------------------------------------
  # AUTO-APPROVE SECURITY REVIEW - NOT required for inventory (confirmed
  # live 2026-09-03: a second run's inventory populated fully with
  # Security Review still PENDING, disproving an earlier coincidental
  # correlation). Kept here anyway since it's harmless and may matter for
  # a future task needing actual cloud-side write/enforcement. Captured
  # the real call the Approve button makes
  # (POST /api/v1/security_review/approve) and confirmed it accepts the
  # same SAAPIKEY Basic auth as everything else here - a request against
  # an already-approved account correctly returned 406 'security review
  # already completed' rather than an auth error, proving the auth path
  # works. There's a real gap between the account registering (srStatus
  # flips to PENDING almost immediately) and the review actually being
  # ready to approve (~5 min observed live) - not a fixed delay we know
  # the length of, so retry rather than assume a wait time. Currently
  # also hits a 500 'failed to set ruleset summaries' on AWS accounts
  # Instruqt has recycled across tenants - a platform-side edge case,
  # not something this retry loop can work around.
  # -----------------------------------------------------------------
  echo '### WAITING FOR SECURITY REVIEW TO BE READY, THEN AUTO-APPROVING ###'
  date
  sr_approved=0
  for attempt in \$(seq 1 40); do
    http_code=\$(curl -s -o /dev/null -w '%{http_code}' -X POST \"https://cloud.illum.io/api/v1/security_review/approve\" \
      -u \"\$AUTOACCOUNT_SAAPIKEY_KEYID:\$AUTOACCOUNT_SAAPIKEY_SECRET\" \
      -H \"X-Tenant-Id: \$AUTOACCOUNT_TENANT_ID\" \
      -H \"Content-Type: application/json\" \
      -d \"{\\\"account_id\\\":\\\"\$AWS_ACCT_ID\\\",\\\"cloud\\\":\\\"aws\\\",\\\"enable_account_rw\\\":false,\\\"security_review_status\\\":\\\"APPROVED\\\"}\")
    if [ \"\$http_code\" = \"200\" ]; then
      echo \"Security Review approved after \$attempt attempt(s)\"
      sr_approved=1
      break
    fi
    echo \"Attempt \$attempt: security_review/approve returned \$http_code, retrying in 15s...\"
    sleep 15
  done
  if [ \"\$sr_approved\" != \"1\" ]; then
    echo '### SECURITY REVIEW APPROVAL NEVER SUCCEEDED - inventory may stay empty ###'
  fi
  echo '### SECURITY REVIEW AUTO-APPROVAL STEP COMPLETE ###'
  date

  # -----------------------------------------------------------------
  # TAG-TO-LABEL MAPPING + APPLICATION DISCOVERY - both confirmed
  # automatable live 2026-09-03 with the same SAAPIKEY Basic auth. Waits
  # for inventory to actually exist first (bridge/resources non-empty) -
  # the real ~15-25 min propagation window this whole track exists to
  # hide - before attempting either, since both need indexed tag data to
  # mean anything. Role/Location go through Tag-to-Label Mapping
  # (POST /api/v1/tags_to_label) - confirmed live that 'app'/'env' are
  # deliberately REJECTED there ('cannot be used for tag to label
  # mappings'), by design: those two are meant to come from Application
  # Discovery instead (POST /api/v1/discovery_rules), which resolved a
  # matching Application Definition in under 2 seconds in testing, twice.
  # -----------------------------------------------------------------
  echo '### WAITING FOR INVENTORY TO SYNC ###'
  date
  inventory_ready=0
  for attempt in \$(seq 1 90); do
    item_count=\$(curl -s -X POST \"https://cloud.illum.io/api/v1/bridge/resources\" \
      -u \"\$AUTOACCOUNT_SAAPIKEY_KEYID:\$AUTOACCOUNT_SAAPIKEY_SECRET\" \
      -H \"X-Tenant-Id: \$AUTOACCOUNT_TENANT_ID\" \
      -H \"Content-Type: application/json\" \
      -d '{\"exclude_references\": false, \"max_results\": 1, \"page_token\": null, \"sortBy\": {}, \"with_total_count\": true}' \
      | python3 -c \"import json,sys; print(len(json.load(sys.stdin).get('items',[])))\" 2>/dev/null)
    if [ \"\$item_count\" != \"0\" ] && [ -n \"\$item_count\" ]; then
      echo \"Inventory ready after \$attempt attempt(s)\"
      inventory_ready=1
      break
    fi
    echo \"Attempt \$attempt: inventory not ready yet, retrying in 20s...\"
    sleep 20
  done

  if [ \"\$inventory_ready\" = \"1\" ]; then
    echo '### CREATING TAG-TO-LABEL MAPPING: role -> Role ###'
    date
    curl -s -X POST \"https://cloud.illum.io/api/v1/tags_to_label\" \
      -u \"\$AUTOACCOUNT_SAAPIKEY_KEYID:\$AUTOACCOUNT_SAAPIKEY_SECRET\" \
      -H \"X-Tenant-Id: \$AUTOACCOUNT_TENANT_ID\" \
      -H \"Content-Type: application/json\" \
      -d '{\"key\":\"role\",\"display_name\":\"Role\",\"display_info\":{\"icon\":\"role\"},\"tag_keys\":[{\"key\":\"role\",\"cloud\":\"aws\",\"id\":\"0\",\"created\":false}]}'
    echo

    echo '### CREATING APPLICATION DISCOVERY RULE: aws:app ###'
    date
    curl -s -X POST \"https://cloud.illum.io/api/v1/discovery_rules\" \
      -u \"\$AUTOACCOUNT_SAAPIKEY_KEYID:\$AUTOACCOUNT_SAAPIKEY_SECRET\" \
      -H \"X-Tenant-Id: \$AUTOACCOUNT_TENANT_ID\" \
      -H \"Content-Type: application/json\" \
      -d '{\"auto_approve_applications\":true,\"name\":\"aws-auto-discovery\",\"prefix\":\"\",\"rule_type\":\"TAG\",\"tag_keys\":[{\"cloud\":\"aws\",\"key\":\"app\"}]}'
    echo
  else
    echo '### INVENTORY NEVER SYNCED WITHIN 30 MIN - SKIPPING TAG MAPPING / DISCOVERY ###'
  fi
  echo '### TAG-TO-LABEL MAPPING + APPLICATION DISCOVERY STEP COMPLETE ###'
  date

" > /var/log/aws-onboard-startup.log 2>&1 < /dev/null &

echo "===== MAGIC LINK + ACCOUNT SETUP END ====="
