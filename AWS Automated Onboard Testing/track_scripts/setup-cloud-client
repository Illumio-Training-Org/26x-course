#!/bin/bash
set -exo

echo "===== MAGIC LINK + ACCOUNT SETUP START ====="
date

# ---------------------------------------
# Ensure required tools are present and updated
# ---------------------------------------

apt-get update -y
apt-get install --only-upgrade -y curl git

# ---------------------------------------
# Sanitize AUTOACCOUNT_* values
# ---------------------------------------
# Instruqt's autoaccount custom resource emits these as JSON-array-literal
# strings (e.g. '["value"]') even with account_count: 1, not bare scalars.
for var in AUTOACCOUNT_TENANT_ID AUTOACCOUNT_APIKEY_ID AUTOACCOUNT_APIKEY_SECRET \
           AUTOACCOUNT_ORG_ID AUTOACCOUNT_PCE_FQDN AUTOACCOUNT_SAAPIKEY_KEYID \
           AUTOACCOUNT_SAAPIKEY_SECRET; do
  cleaned="$(echo "${!var}" | tr -d '{}[]"')"
  export "$var=$cleaned"
done

# Also make the cleaned values visible to any new terminal tab the
# learner opens - the container's own injected env vars are still the
# raw/dirty ones, so override them for every future interactive shell
# via .bashrc.
{
  for var in AUTOACCOUNT_TENANT_ID AUTOACCOUNT_APIKEY_ID AUTOACCOUNT_APIKEY_SECRET \
             AUTOACCOUNT_ORG_ID AUTOACCOUNT_PCE_FQDN AUTOACCOUNT_SAAPIKEY_KEYID \
             AUTOACCOUNT_SAAPIKEY_SECRET; do
    printf 'export %s=%q\n' "$var" "${!var}"
  done
} >> /root/.bashrc

# ---------------------------------------
# Parse PCE FQDN
# ---------------------------------------
if [[ "$AUTOACCOUNT_PCE_FQDN" == *:* ]]; then
  pceFqdn=${AUTOACCOUNT_PCE_FQDN%%:*}
  pcePort=${AUTOACCOUNT_PCE_FQDN##*:}
else
  echo "ERROR: AUTOACCOUNT_PCE_FQDN does not contain a port."
  exit 1
fi

# ---------------------------------------
# Save variables for later use (Instruqt state)
# ---------------------------------------
agent variable set ACCOUNTID "$AUTOACCOUNT_TENANT_ID"
agent variable set APINAME "api_${AUTOACCOUNT_APIKEY_ID}"
agent variable set APISECRET "$AUTOACCOUNT_APIKEY_SECRET"
agent variable set ORGID "$AUTOACCOUNT_ORG_ID"
agent variable set PCEFQDN "$pceFqdn"
agent variable set PCEPort "$pcePort"
agent variable set SACLIENT "$AUTOACCOUNT_SAAPIKEY_KEYID"
agent variable set SASECRET "$AUTOACCOUNT_SAAPIKEY_SECRET"

# ---------------------------------------
# MAGIC LINK SETUP
# ---------------------------------------
MAGIC_LINK=$(echo "${AUTOACCOUNT_MAGICLINK}" | tr -d '{}[]"')

echo "Generated MAGIC LINK:"
echo "$MAGIC_LINK"

agent variable set MAGICURL "$MAGIC_LINK"

git clone https://github.com/jdschmitz15/illumio-instruqt-terraform-template.git
AUTOACCOUNT_MAGICLINK="$MAGIC_LINK"
gomplate -f ~/illumio-instruqt-terraform-template/index.html.tmpl -o /var/www/html/index.html
date

# ---------------------------------------
# SELF-CHECK SCRIPT
# ---------------------------------------
cat > /usr/local/bin/check-cloud << 'CHECKEOF'
#!/bin/bash
clear
AUTH2="${AUTOACCOUNT_SAAPIKEY_KEYID}:${AUTOACCOUNT_SAAPIKEY_SECRET}"
curl -s -u "$AUTH2" -H "X-Tenant-Id: $AUTOACCOUNT_TENANT_ID" "https://cloud.illum.io/api/v1/integrations" | python3 -c "
import json, sys
d = json.load(sys.stdin)
aws = d.get('aws', [])
if not aws:
    print('FAIL - no AWS account onboarded yet')
else:
    a = aws[0]
    print('PASS - AWS account onboarded: ' + str(a.get('name')) + ' (status: ' + str(a.get('status')) + ', security review: ' + str(a.get('srStatus')) + ')')
"
CHECKEOF
chmod +x /usr/local/bin/check-cloud

# ---------------------------------------
# AWS BUILD (Terraform) + AUTOMATED ONBOARDING - runs in background,
# no vensim, no VMs. Prototype for whether onboarding can be triggered
# without a learner ever touching the Cloud -> Onboarding wizard.
# ---------------------------------------
nohup bash -c "
  set -ex
  export AWS_REGION=us-east-1
  export AWS_DEFAULT_REGION=us-east-1

  cd /root
  git clone https://github.com/Illumio-Training-Org/26x-course.git
  cd /root/26x-course/terraform

  # Install Terraform
  curl -fsSL https://apt.releases.hashicorp.com/gpg | gpg --yes --dearmor -o /usr/share/keyrings/hashicorp-archive-keyring.gpg
  echo \"deb [signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com \$(lsb_release -cs) main\" > /etc/apt/sources.list.d/hashicorp.list
  apt-get update -o Dir::Etc::sourcelist=\"sources.list.d/hashicorp.list\" -o Dir::Etc::sourceparts=\"-\" -o APT::Get::List-Cleanup=\"0\"
  apt-get install -y terraform

  terraform init -input=false
  terraform plan -out=tfplan -input=false
  terraform apply -input=false -auto-approve tfplan

  echo '### TERRAFORM APPLY COMPLETE ###'
  date

  # -----------------------------------------------------------------
  # AUTOMATED ILLUMIO CLOUD ONBOARDING - separate, isolated Terraform
  # config (not the shared terraform/ folder, so this experiment can't
  # break Course Lab or any exam track). Uses the official
  # illumio/illumio-cloudsecure Terraform provider, modeled on a
  # colleague's working example (Instruqt track grsxrhaf37xt).
  # -----------------------------------------------------------------
  echo '### STARTING AUTOMATED CLOUDSECURE ONBOARDING ###'
  date
  cd /root/26x-course/terraform-cloudsecure-aws

  terraform init -input=false
  terraform plan -out=tfplan -input=false \
    -var \"illumio_cloudsecure_client_id=\$AUTOACCOUNT_SAAPIKEY_KEYID\" \
    -var \"illumio_cloudsecure_client_secret=\$AUTOACCOUNT_SAAPIKEY_SECRET\"
  terraform apply -input=false -auto-approve tfplan

  echo '### AUTOMATED CLOUDSECURE ONBOARDING APPLY COMPLETE ###'
  date

" > /var/log/aws-onboard-startup.log 2>&1 < /dev/null &

echo "===== MAGIC LINK + ACCOUNT SETUP END ====="
