#!/bin/sh
#
# This script runs when the platform checks the challenge.
# Exit 0 = pass, non-zero = fail.
#

# setup-cloud-client writes cleaned AUTOACCOUNT_* values here since this
# script's execution context doesn't source .bashrc (interactive-only).
. /root/.autoaccount_env

BASE="https://$AUTOACCOUNT_PCE_FQDN/api/v2/orgs/$AUTOACCOUNT_ORG_ID"
AUTH="api_${AUTOACCOUNT_APIKEY_ID}:${AUTOACCOUNT_APIKEY_SECRET}"

curl -s -u "$AUTH" "$BASE/workloads?max_results=1000" | python3 -c "
import json, sys
ws = {w.get('hostname'): w for w in json.load(sys.stdin)}
paired = [h for h in ('linux-vm', 'windows-vm') if ws.get(h) and ws[h].get('ven')]
if not paired:
    print('FAIL - no workload paired as a VEN yet')
    sys.exit(1)
print('PASS - paired: ' + ', '.join(paired))
"
exit $?
