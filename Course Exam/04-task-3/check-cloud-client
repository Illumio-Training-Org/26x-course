#!/bin/sh
#
# This script runs when the platform checks the challenge.
# Exit 0 = pass, non-zero = fail.
#

BASE="https://$AUTOACCOUNT_PCE_FQDN/api/v2/orgs/$AUTOACCOUNT_ORG_ID"
AUTH="api_${AUTOACCOUNT_APIKEY_ID}:${AUTOACCOUNT_APIKEY_SECRET}"

fails=""

label_ok=$(curl -s -u "$AUTH" "$BASE/labels" | python3 -c "
import json, sys
d = json.load(sys.stdin)
found = [x for x in d if x.get('key') == 'role' and (x.get('value') or '').lower() == 'task3role']
print('1' if found else '0')
")
[ "$label_ok" = "0" ] && fails="$fails\n - Role label Task3Role not found"

lg_ok=$(curl -s -u "$AUTH" "$BASE/sec_policy/draft/label_groups" | python3 -c "
import json, sys
d = json.load(sys.stdin)
found = [x for x in d if (x.get('name') or '').lower() == 'task3-labelgroup' and x.get('labels')]
print('1' if found else '0')
")
[ "$lg_ok" = "0" ] && fails="$fails\n - Task3-LabelGroup not found or has no labels"

ip_ok=$(curl -s -u "$AUTH" "$BASE/sec_policy/draft/ip_lists" | python3 -c "
import json, sys
d = json.load(sys.stdin)
found = [x for x in d if (x.get('name') or '').lower() == 'task3-iplist']
ok = found and any(r.get('from_ip') == '10.30.30.0/24' for r in found[0].get('ip_ranges', []))
print('1' if ok else '0')
")
[ "$ip_ok" = "0" ] && fails="$fails\n - Task3-IPList not found or missing 10.30.30.0/24"

if [ -n "$fails" ]; then
  printf "FAIL$fails\n"
  exit 1
fi
echo "PASS - label, label group, and IP list all found"
exit 0
