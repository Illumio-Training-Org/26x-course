#!/bin/sh
#
# This script runs when the platform checks the challenge.
# Exit 0 = pass, non-zero = fail.
#

# setup-cloud-client writes cleaned AUTOACCOUNT_* values here since this
# script's execution context doesn't source .bashrc (interactive-only).
. /root/.autoaccount_env

BASE="https://$AUTOACCOUNT_PCE_FQDN/api/v2/orgs/$AUTOACCOUNT_ORG_ID"
AUTH="api_${AUTOACCOUNT_APIKEY_ID}:${AUTOACCOUNT_APIKEY_SECRET}"
FQDN="$AUTOACCOUNT_PCE_FQDN"

result=$(curl -s -u "$AUTH" "$BASE/sec_policy/active/rule_sets" | python3 -c "
import json, sys, subprocess

d = json.load(sys.stdin)
rs = [x for x in d if (x.get('name') or '').lower() == 'task4-ruleset']
if not rs:
    print('Task4-Ruleset not found in provisioned (active) policy - create it and provision it')
    sys.exit(1)

drs = rs[0].get('deny_rules', [])
if len(drs) != 1:
    print('Task4-Ruleset found but expected 1 deny rule, found ' + str(len(drs)))
    sys.exit(1)

dr = drs[0]
fails = []

svc = dr.get('ingress_services', [])
if svc != [{'port': 1234, 'proto': 6}]:
    fails.append('ingress_services should be tcp/1234, found ' + str(svc))

def resolve_labels(entries):
    result = {}
    for e in entries:
        href = e['label']['href']
        url = 'https://$FQDN/api/v2' + href
        out = subprocess.run(['curl', '-s', '-u', '$AUTH', url], capture_output=True, text=True).stdout
        lbl = json.loads(out)
        result[lbl['key']] = lbl['value']
    return result

providers = resolve_labels(dr.get('providers', []))
consumers = resolve_labels(dr.get('consumers', []))

if not (providers.get('env') == 'Production' and providers.get('loc') == 'lax'):
    fails.append('providers should be env=Production, loc=lax, found ' + str(providers))
if not (consumers.get('env') == 'Production' and consumers.get('loc') == 'ca'):
    fails.append('consumers should be env=Production, loc=ca, found ' + str(consumers))

if fails:
    print('; '.join(fails))
    sys.exit(1)
print('Task4-Ruleset provisioned and correctly configured')
")
status=$?
echo "$result"
if [ "$status" -ne 0 ]; then
  fail-message "$result"
  exit 1
fi
exit 0
