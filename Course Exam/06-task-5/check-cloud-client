#!/bin/sh
#
# This script runs when the platform checks the challenge.
# Exit 0 = pass, non-zero = fail.
#

AUTH2="${AUTOACCOUNT_SAAPIKEY_KEYID}:${AUTOACCOUNT_SAAPIKEY_SECRET}"

curl -s -u "$AUTH2" -H "X-Tenant-Id: $AUTOACCOUNT_TENANT_ID" "https://cloud.illum.io/api/v1/integrations" | python3 -c "
import json, sys
d = json.load(sys.stdin)
aws = d.get('aws', [])
if not aws:
    print('FAIL - no AWS account onboarded yet')
    sys.exit(1)
print('PASS - AWS account onboarded: ' + str(aws[0].get('name')))
"
exit $?
