#!/bin/sh
#
# This script runs when the platform checks the challenge.
# Exit 0 = pass, non-zero = fail.
#

# setup-cloud-client writes cleaned AUTOACCOUNT_* values here since this
# script's execution context doesn't source .bashrc (interactive-only).
. /root/.autoaccount_env

BASE="https://$AUTOACCOUNT_PCE_FQDN/api/v2/orgs/$AUTOACCOUNT_ORG_ID"
AUTH="api_${AUTOACCOUNT_APIKEY_ID}:${AUTOACCOUNT_APIKEY_SECRET}"
FQDN="$AUTOACCOUNT_PCE_FQDN"

result=$(python3 -c "
import json, subprocess, sys

def get(path):
    url = 'https://$FQDN/api/v2' + path
    out = subprocess.run(['curl', '-s', '-u', '$AUTH', url], capture_output=True, text=True).stdout
    return json.loads(out)

expected = {'app': 'ordering', 'env': 'production', 'loc': 'ca'}

def resolve(entries):
    out = {}
    for e in entries:
        href = e.get('label', {}).get('href')
        if not href:
            continue
        lbl = get(href.replace('/api/v2', ''))
        out[lbl['key']] = (lbl.get('value') or '').lower()
    return out

rulesets = []
for policy in ('draft', 'active'):
    rulesets += get('/orgs/$AUTOACCOUNT_ORG_ID/sec_policy/' + policy + '/rule_sets')

named = [rs for rs in rulesets if (rs.get('name') or '').lower() == 'task4-denypolicy']
if not named:
    print('Ruleset Task4-DenyPolicy not found')
    sys.exit(1)

def has_tcp_22(ingress_services):
    # Accept either a linked service object (student picked the
    # built-in 'SSH' service, which already bundles tcp/22 + udp/22
    # together - tcp/22 alone is enough to confirm it) or manually-typed
    # inline port/proto entries - but if typed manually, both tcp/22 AND
    # udp/22 must be present, matching what the SSH service itself
    # bundles.
    inline_ports = {(e.get('port'), e.get('proto')) for e in (ingress_services or []) if 'port' in e}
    if (22, 6) in inline_ports and (22, 17) in inline_ports:
        return True
    for entry in ingress_services or []:
        href = entry.get('href')
        if href:
            svc = get(href.replace('/api/v2', ''))
            for sp in svc.get('service_ports', []):
                if sp.get('port') == 22 and sp.get('proto') == 6:
                    return True
    return False

def describe_services(ingress_services):
    # Human-readable version of ingress_services for fail messages -
    # a linked service is just {'href': ...} otherwise, unreadable to
    # a learner (live-observed 2026-09-02).
    out = []
    for entry in ingress_services or []:
        href = entry.get('href')
        if href:
            svc = get(href.replace('/api/v2', ''))
            out.append(svc.get('name') or href)
        elif 'port' in entry:
            proto = 'tcp' if entry.get('proto') == 6 else 'udp' if entry.get('proto') == 17 else str(entry.get('proto'))
            out.append(str(entry.get('port')) + '/' + proto)
        else:
            out.append(str(entry))
    return out

def is_all_workloads(consumers):
    # 'All Workloads' as a consumer is an actors:'ams' entry - the API
    # rejects an empty consumers list outright (live-verified), but the
    # empty-list check stays as a harmless fallback in case a rule was
    # ever built some other way.
    if not consumers:
        return True
    return any(c.get('actors') == 'ams' for c in consumers)

def describe_consumers(consumers):
    # Human-readable version of consumers for fail messages - a linked
    # ip_list/label/workload is just {'href': ...} otherwise, unreadable
    # to a learner (same class of bug as describe_services, live-observed
    # 2026-09-02).
    out = []
    for c in consumers or []:
        if c.get('actors') == 'ams':
            out.append('All Workloads')
            continue
        described = False
        for key in ('ip_list', 'label', 'label_group', 'workload', 'virtual_service', 'virtual_server'):
            ref = c.get(key)
            if ref and ref.get('href'):
                obj = get(ref['href'].replace('/api/v2', ''))
                out.append(obj.get('name') or ref['href'])
                described = True
                break
        if not described:
            out.append(str(c))
    return out

reasons = []
for rs in named:
    for dr in rs.get('deny_rules', []):
        providers = resolve(dr.get('providers', []))
        labels_ok = all(providers.get(k) == v for k, v in expected.items())
        svc_ok = has_tcp_22(dr.get('ingress_services'))
        from_all_ok = is_all_workloads(dr.get('consumers', []))
        if labels_ok and svc_ok and from_all_ok:
            print('Found a deny rule: SSH, from All Workloads, to Application=ordering/Environment=Production/Location=ca in Task4-DenyPolicy')
            sys.exit(0)
        if labels_ok:
            missing = []
            if not svc_ok:
                missing.append('service should deny SSH - either the built-in SSH service, or both tcp/22 and udp/22 entered manually, found ' + str(describe_services(dr.get('ingress_services'))))
            if not from_all_ok:
                missing.append('source should be All Workloads, found ' + str(describe_consumers(dr.get('consumers'))))
            reasons.append('; '.join(missing))

if reasons:
    print('Task4-DenyPolicy has a rule targeting the right labels but: ' + '; '.join(reasons))
else:
    print('Task4-DenyPolicy exists but has no deny rule targeting Application=ordering, Environment=Production, Location=ca')
sys.exit(1)
")
status=$?
if [ "$status" -ne 0 ]; then
  fail-message "$result"
  exit 1
fi
echo "$result"
exit 0
