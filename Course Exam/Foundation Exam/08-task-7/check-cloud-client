#!/bin/sh
#
# This script runs when the platform checks the challenge.
# Exit 0 = pass, non-zero = fail.
#
# Checks the PCE's /permissions endpoint for a role assignment scoped
# to Environment=Production, Location=ca with the Ruleset Manager role.
# Confirmed live 2026-08-28 against a real /permissions response:
#   [{"href":..., "role":{"href":".../roles/ruleset_manager"},
#     "scope":[{"label":{"href":...}}, {"label":{"href":...}}],
#     "auth_security_principal":{"href":...}}, ...]
# scope is a FLAT list of {"label":{"href":...}} entries (not a list
# of groups), and auth_security_principal has no "type" field.

# setup-cloud-client writes cleaned AUTOACCOUNT_* values here since this
# script's execution context doesn't source .bashrc (interactive-only).
. /root/.autoaccount_env

BASE="https://$AUTOACCOUNT_PCE_FQDN/api/v2/orgs/$AUTOACCOUNT_ORG_ID"
AUTH="api_${AUTOACCOUNT_APIKEY_ID}:${AUTOACCOUNT_APIKEY_SECRET}"
FQDN="$AUTOACCOUNT_PCE_FQDN"

result=$(python3 -c "
import json, subprocess, sys

def get(path):
    url = 'https://$FQDN/api/v2' + path
    out = subprocess.run(['curl', '-s', '-u', '$AUTH', url], capture_output=True, text=True).stdout
    try:
        return json.loads(out)
    except Exception:
        return None

expected_scope = {'env': 'production', 'loc': 'ca'}

perms = get('/orgs/$AUTOACCOUNT_ORG_ID/permissions')
if perms is None:
    print('Could not read /permissions - create a scoped role assignment for a user')
    sys.exit(1)

def resolve_label(href):
    lbl = get(href.replace('/api/v2', ''))
    if not lbl:
        return None
    return lbl.get('key'), (lbl.get('value') or '').lower()

for p in perms:
    role_href = (p.get('role') or {}).get('href', '')
    if 'ruleset_manager' not in role_href:
        continue
    scope = p.get('scope') or []
    if not scope:
        continue  # empty scope = org-wide, not what we want
    matched = {}
    for entry in scope:
        href = (entry.get('label') or {}).get('href')
        if not href:
            continue
        kv = resolve_label(href)
        if kv:
            matched[kv[0]] = kv[1]
    if all(matched.get(k) == v for k, v in expected_scope.items()):
        print('Found a user with Ruleset Manager scoped to Environment=Production, Location=ca')
        sys.exit(0)

print('No user found with the Ruleset Manager role scoped specifically to Environment=Production, Location=ca')
sys.exit(1)
")
status=$?
if [ "$status" -ne 0 ]; then
  fail-message "$result"
  exit 1
fi
echo "$result"
exit 0
