#!/bin/sh
#
# Runs when the learner clicks Skip. Best-effort attempt to create a
# user with the Ruleset Manager role scoped to Environment=Production,
# Location=ca, matching what Task 7 itself asks for.
#
# NOTE: user-creation via /users has NOT been live-verified (we've
# only ever created the test user through the console UI this build
# session) - wrapped so a schema mismatch here just no-ops instead of
# breaking Skip. Fix/verify this against a real sandbox when convenient.

. /root/.autoaccount_env

BASE="https://$AUTOACCOUNT_PCE_FQDN/api/v2/orgs/$AUTOACCOUNT_ORG_ID"
AUTH="api_${AUTOACCOUNT_APIKEY_ID}:${AUTOACCOUNT_APIKEY_SECRET}"
FQDN="$AUTOACCOUNT_PCE_FQDN"

python3 -c "
import json, subprocess

def call(method, path, body=None):
    cmd = ['curl', '-s', '-u', '$AUTH', '-X', method, 'https://$FQDN/api/v2' + path]
    if body is not None:
        cmd += ['-H', 'Content-Type: application/json', '-d', json.dumps(body)]
    out = subprocess.run(cmd, capture_output=True, text=True).stdout
    try:
        return json.loads(out)
    except Exception:
        return None

try:
    def find_or_create_label(key, value):
        labels = call('GET', '/orgs/$AUTOACCOUNT_ORG_ID/labels?max_results=1000') or []
        for l in labels:
            if l.get('key') == key and (l.get('value') or '').lower() == value.lower():
                return l['href']
        created = call('POST', '/orgs/$AUTOACCOUNT_ORG_ID/labels', {'key': key, 'value': value})
        return created['href'] if created else None

    env_href = find_or_create_label('env', 'Production')
    loc_href = find_or_create_label('loc', 'ca')

    user = call('POST', '/users', {
        'first_name': 'Skip',
        'last_name': 'Solved',
        'email': 'skip-solved-task7@example.com',
    })
    principal_href = (user or {}).get('href')

    if principal_href and env_href and loc_href:
        call('POST', '/orgs/$AUTOACCOUNT_ORG_ID/permissions', {
            'role': {'href': '/orgs/$AUTOACCOUNT_ORG_ID/roles/ruleset_manager'},
            'scope': [
                {'label': {'href': env_href}},
                {'label': {'href': loc_href}},
            ],
            'auth_security_principal': {'href': principal_href},
        })
except Exception:
    pass
"

exit 0
