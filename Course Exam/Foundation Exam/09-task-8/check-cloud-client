#!/bin/sh
#
# This script runs when the platform checks the challenge.
# Exit 0 = pass, non-zero = fail.
#

# setup-cloud-client writes cleaned AUTOACCOUNT_* values here since this
# script's execution context doesn't source .bashrc (interactive-only).
. /root/.autoaccount_env

BASE="https://$AUTOACCOUNT_PCE_FQDN/api/v2/orgs/$AUTOACCOUNT_ORG_ID"
AUTH="api_${AUTOACCOUNT_APIKEY_ID}:${AUTOACCOUNT_APIKEY_SECRET}"
FQDN="$AUTOACCOUNT_PCE_FQDN"

result=$(python3 -c "
import json, subprocess, sys

def get(path):
    url = 'https://$FQDN/api/v2' + path
    out = subprocess.run(['curl', '-s', '-u', '$AUTH', url], capture_output=True, text=True).stdout
    return json.loads(out)

reasons = []

# 1) IP List 'remote-office' - range + exclusion
ip_lists = get('/orgs/$AUTOACCOUNT_ORG_ID/sec_policy/draft/ip_lists')
ip_list = next((i for i in ip_lists if (i.get('name') or '').lower() == 'remote-office'), None)
if not ip_list:
    reasons.append('IP List \"remote-office\" not found')
else:
    ranges = ip_list.get('ip_ranges', [])
    has_range = any(r.get('from_ip') == '45.54.45.0/24' and not r.get('exclusion') for r in ranges)
    has_excl = any(r.get('from_ip') == '45.54.45.254' and r.get('exclusion') for r in ranges)
    if not has_range:
        reasons.append('IP List \"remote-office\" is missing the 45.54.45.0/24 range')
    if not has_excl:
        reasons.append('IP List \"remote-office\" is missing the 45.54.45.254 exclusion')

# 2) Label Group 'pci-staging' - env labels pci + staging
def resolve_label_value(href):
    lbl = get(href.replace('/api/v2', ''))
    return (lbl.get('value') or '').lower()

label_groups = get('/orgs/$AUTOACCOUNT_ORG_ID/sec_policy/draft/label_groups')
lg = next((g for g in label_groups if (g.get('name') or '').lower() == 'pci-staging'), None)
if not lg:
    reasons.append('Label Group \"pci-staging\" not found')
else:
    values = set()
    for l in lg.get('labels', []):
        href = l.get('href')
        if href:
            values.add(resolve_label_value(href))
    if not {'pci', 'staging'}.issubset(values):
        reasons.append('Label Group \"pci-staging\" should contain the Environment labels pci and staging, found ' + str(sorted(values)))

# 3) Service 'Redis' - tcp/6379
services = get('/orgs/$AUTOACCOUNT_ORG_ID/sec_policy/draft/services')
has_service = any(
    (s.get('name') or '').lower() == 'redis'
    and any(sp.get('port') == 6379 and sp.get('proto') == 6 for sp in (s.get('service_ports') or []))
    for s in services
)
if not has_service:
    reasons.append('No Service named \"Redis\" found with TCP port 6379')

if reasons:
    print('; '.join(reasons))
    sys.exit(1)
print('IP List remote-office, Label Group pci-staging, and a tcp/6379 Service all found')
sys.exit(0)
")
status=$?
if [ "$status" -ne 0 ]; then
  fail-message "$result"
  exit 1
fi
echo "$result"
exit 0
