#!/bin/sh
#
# Runs when the learner clicks Skip. Creates the IP List, Label Group,
# and Service that Task 8 asks for - none of this depends on linux-vm
# or AWS state, so it fully solves the task.

. /root/.autoaccount_env

BASE="https://$AUTOACCOUNT_PCE_FQDN/api/v2/orgs/$AUTOACCOUNT_ORG_ID"
AUTH="api_${AUTOACCOUNT_APIKEY_ID}:${AUTOACCOUNT_APIKEY_SECRET}"
FQDN="$AUTOACCOUNT_PCE_FQDN"

python3 -c "
import json, subprocess

def call(method, path, body=None):
    cmd = ['curl', '-s', '-u', '$AUTH', '-X', method, 'https://$FQDN/api/v2' + path]
    if body is not None:
        cmd += ['-H', 'Content-Type: application/json', '-d', json.dumps(body)]
    out = subprocess.run(cmd, capture_output=True, text=True).stdout
    try:
        return json.loads(out)
    except Exception:
        return None

# 1) IP List
ip_lists = call('GET', '/orgs/$AUTOACCOUNT_ORG_ID/sec_policy/draft/ip_lists') or []
if not any((i.get('name') or '').lower() == 'remote-office' for i in ip_lists):
    call('POST', '/orgs/$AUTOACCOUNT_ORG_ID/sec_policy/draft/ip_lists', {
        'name': 'remote-office',
        'ip_ranges': [
            {'from_ip': '45.54.45.0/24'},
            {'from_ip': '45.54.45.254', 'exclusion': True},
        ],
    })

# 2) Label Group
def find_or_create_label(key, value):
    labels = call('GET', '/orgs/$AUTOACCOUNT_ORG_ID/labels?max_results=1000') or []
    for l in labels:
        if l.get('key') == key and (l.get('value') or '').lower() == value.lower():
            return l['href']
    created = call('POST', '/orgs/$AUTOACCOUNT_ORG_ID/labels', {'key': key, 'value': value})
    return created['href'] if created else None

pci_href = find_or_create_label('env', 'pci')
staging_href = find_or_create_label('env', 'staging')

label_groups = call('GET', '/orgs/$AUTOACCOUNT_ORG_ID/sec_policy/draft/label_groups') or []
if not any((g.get('name') or '').lower() == 'pci-staging' for g in label_groups):
    call('POST', '/orgs/$AUTOACCOUNT_ORG_ID/sec_policy/draft/label_groups', {
        'name': 'pci-staging',
        'key': 'env',
        'labels': [{'href': pci_href}, {'href': staging_href}],
    })

# 3) Service 'Redis'
services = call('GET', '/orgs/$AUTOACCOUNT_ORG_ID/sec_policy/draft/services') or []
has_service = any(
    (s.get('name') or '').lower() == 'redis'
    and any(sp.get('port') == 6379 and sp.get('proto') == 6 for sp in (s.get('service_ports') or []))
    for s in services
)
if not has_service:
    call('POST', '/orgs/$AUTOACCOUNT_ORG_ID/sec_policy/draft/services', {
        'name': 'Redis',
        'service_ports': [{'port': 6379, 'proto': 6}],
    })
"

exit 0
