#!/bin/sh
#
# Runs when the learner clicks Skip. Brings the sandbox to the same
# end-state Task 9 itself asks for: the rogue Role label gone.

. /root/.autoaccount_env

BASE="https://$AUTOACCOUNT_PCE_FQDN/api/v2/orgs/$AUTOACCOUNT_ORG_ID"
# Use whichever key works: service account first, then magic-link.
# Full path: Instruqt runs checks with a minimal PATH (no /usr/local/bin).
# If pce-auth is missing or prints nothing, use the magic-link key.
AUTH=$(/usr/local/bin/pce-auth 2>/dev/null)
[ -n "$AUTH" ] || AUTH="api_${AUTOACCOUNT_APIKEY_ID}:${AUTOACCOUNT_APIKEY_SECRET}"

href=$(curl -s -u "$AUTH" "$BASE/labels?max_results=1000" | python3 -c "
import json, sys
d = json.load(sys.stdin)
found = [x for x in d if x.get('key') == 'role' and (x.get('value') or '').lower() == 'rogue-donotuse']
print(found[0]['href'] if found else '')
")

if [ -n "$href" ]; then
  curl -s -u "$AUTH" -X DELETE "https://$AUTOACCOUNT_PCE_FQDN/api/v2$href" > /dev/null
fi

exit 0
