#!/bin/sh
#
# Runs when the learner clicks Skip. Creates Task5-DenyDevProd - pure
# org-level objects, no dependency on workload pairing state.
#
# Fixed 2026-09-07: previously used a raw TCP 1-65535 port range for
# the deny rule's service, which the UI shows as "1 - 65535 TCP" - not
# the same as "All Services" (misses other protocols like UDP/ICMP).
# Live-verified a deny_rule accepts the real "All Services" service
# object href directly, same as an allow rule.

. /root/.autoaccount_env

AUTH="api_${AUTOACCOUNT_APIKEY_ID}:${AUTOACCOUNT_APIKEY_SECRET}"
FQDN="$AUTOACCOUNT_PCE_FQDN"

python3 -c "
import json, subprocess

def call(method, path, body=None):
    cmd = ['curl', '-s', '-u', '$AUTH', '-X', method, 'https://$FQDN/api/v2' + path]
    if body is not None:
        cmd += ['-H', 'Content-Type: application/json', '-d', json.dumps(body)]
    out = subprocess.run(cmd, capture_output=True, text=True).stdout
    try:
        return json.loads(out)
    except Exception:
        return None

def find_or_create_label(key, value):
    labels = call('GET', '/orgs/$AUTOACCOUNT_ORG_ID/labels?max_results=1000') or []
    for l in labels:
        if l.get('key') == key and (l.get('value') or '').lower() == value.lower():
            return l['href']
    created = call('POST', '/orgs/$AUTOACCOUNT_ORG_ID/labels', {'key': key, 'value': value})
    return created['href'] if created else None

def find_all_services_href():
    services = call('GET', '/orgs/$AUTOACCOUNT_ORG_ID/sec_policy/draft/services?max_results=1000') or []
    for s in services:
        if (s.get('name') or '').lower() == 'all services':
            return s['href']
    return None

app_href = find_or_create_label('app', 'ordering')
dev_href = find_or_create_label('env', 'Development')
prod_href = find_or_create_label('env', 'Production')
loc_href = find_or_create_label('loc', 'ca')
all_services_href = find_all_services_href()

rulesets = call('GET', '/orgs/$AUTOACCOUNT_ORG_ID/sec_policy/draft/rule_sets') or []
if not any((r.get('name') or '').lower() == 'task5-denydevprod' for r in rulesets):
    call('POST', '/orgs/$AUTOACCOUNT_ORG_ID/sec_policy/draft/rule_sets', {
        'name': 'Task5-DenyDevProd',
        'scopes': [[]],
        'deny_rules': [{
            'ingress_services': [{'href': all_services_href}] if all_services_href else [],
            'consumers': [
                {'label': {'href': app_href}},
                {'label': {'href': dev_href}},
                {'label': {'href': loc_href}},
            ],
            'providers': [
                {'label': {'href': app_href}},
                {'label': {'href': prod_href}},
                {'label': {'href': loc_href}},
            ],
        }],
    })
"

exit 0
