#!/bin/sh
#
# This script runs when the platform checks the challenge.
# Exit 0 = pass, non-zero = fail.
#
# Fixed 2026-09-11: previously only checked that the 3 required labels
# were present on each side, so an extra label (e.g. Role=web added to
# the destination) went undetected and the rule still passed -
# live-caught by Nathan. The task wants exactly these 3 labels on each
# side, nothing else - now rejects any extra label too.

. /root/.autoaccount_env

BASE="https://$AUTOACCOUNT_PCE_FQDN/api/v2/orgs/$AUTOACCOUNT_ORG_ID"
AUTH="api_${AUTOACCOUNT_APIKEY_ID}:${AUTOACCOUNT_APIKEY_SECRET}"
FQDN="$AUTOACCOUNT_PCE_FQDN"

result=$(python3 -c "
import json, subprocess, sys

def get(path):
    url = 'https://$FQDN/api/v2' + path
    out = subprocess.run(['curl', '-s', '-u', '$AUTH', url], capture_output=True, text=True).stdout
    return json.loads(out)

def resolve(entries):
    out = {}
    for e in entries:
        href = (e.get('label') or {}).get('href')
        if not href:
            continue
        lbl = get(href.replace('/api/v2', ''))
        out[(lbl.get('key') or '').lower()] = (lbl.get('value') or '').lower()
    return out

rulesets = get('/orgs/$AUTOACCOUNT_ORG_ID/sec_policy/draft/rule_sets')
rs = next((r for r in rulesets if (r.get('name') or '').lower() == 'task5-denydevprod'), None)
if not rs:
    print('Policy \"Task5-DenyDevProd\" not found')
    sys.exit(1)

# Scopes aren't taught in this course - this task does NOT accept a
# Scope-based ruleset, ca must be repeated explicitly on both the
# consumer and provider side of the deny rule.
for scope_group in rs.get('scopes', []):
    if scope_group:
        print('Task5-DenyDevProd should not use a Scope - repeat Location=ca explicitly on both sides of the deny rule instead')
        sys.exit(1)

def is_all_services(ingress_services):
    if not ingress_services:
        return True
    for entry in ingress_services:
        href = entry.get('href')
        if href:
            svc = get(href.replace('/api/v2', ''))
            if (svc.get('name') or '').lower() == 'all services':
                return True
    return False

want_consumer = {'app': 'ordering', 'env': 'development', 'loc': 'ca'}
want_provider = {'app': 'ordering', 'env': 'production', 'loc': 'ca'}

def label_problems(name, found, expected):
    problems = []
    for key, want in expected.items():
        got = found.get(key)
        if got != want:
            problems.append(name + ' ' + key + ' should be ' + want + ', found ' + (got or 'missing'))
    extra = set(found) - set(expected)
    if extra:
        problems.append(name + ' has unexpected extra label(s): ' + ', '.join(sorted(extra)))
    return problems

best_reasons = None
for dr in rs.get('deny_rules', []):
    consumers = resolve(dr.get('consumers', []))
    providers = resolve(dr.get('providers', []))
    problems = label_problems('source', consumers, want_consumer) + label_problems('destination', providers, want_provider)
    service_ok = is_all_services(dr.get('ingress_services'))
    if not problems and service_ok:
        print('Found the Dev->Prod deny rule for ordering in ca, All Services')
        sys.exit(0)
    if not problems and not service_ok:
        problems = ['should be for All Services, not a specific service/port range']
    if best_reasons is None or len(problems) < len(best_reasons):
        best_reasons = problems

if best_reasons:
    print('Task5-DenyDevProd rule is close but: ' + '; '.join(best_reasons))
else:
    print('Task5-DenyDevProd exists but has no rule denying Dev->Prod for ordering in ca')
sys.exit(1)
")
status=$?
if [ "$status" -ne 0 ]; then
  fail-message "$result"
  exit 1
fi
echo "$result"
exit 0
