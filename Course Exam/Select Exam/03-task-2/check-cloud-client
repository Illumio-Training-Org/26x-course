#!/bin/sh
#
# This script runs when the platform checks the challenge.
# Exit 0 = pass, non-zero = fail.
#
# Scopes aren't taught in the 5-day class, so the task doesn't ask for
# one by name - but a learner who already knows Scopes might still use
# one, so this accepts either: a real Scope (the 5 labels below) with
# an intra-scope All Workloads/All Services allow rule, or a scopeless
# ruleset with an allow rule that has the same 5 labels repeated on
# both source and destination. NOT YET LIVE-VERIFIED against a real
# sandbox - refine once tested.

. /root/.autoaccount_env

BASE="https://$AUTOACCOUNT_PCE_FQDN/api/v2/orgs/$AUTOACCOUNT_ORG_ID"
AUTH="api_${AUTOACCOUNT_APIKEY_ID}:${AUTOACCOUNT_APIKEY_SECRET}"
FQDN="$AUTOACCOUNT_PCE_FQDN"

result=$(python3 -c "
import json, subprocess, sys

def get(path):
    url = 'https://$FQDN/api/v2' + path
    out = subprocess.run(['curl', '-s', '-u', '$AUTH', url], capture_output=True, text=True).stdout
    return json.loads(out)

def resolve_labels(entries):
    out = set()
    for e in entries:
        href = (e.get('label') or {}).get('href') or e.get('href')
        if href:
            lbl = get(href.replace('/api/v2', ''))
            out.add(((lbl.get('key') or '').lower(), (lbl.get('value') or '').lower()))
    return out

ws = {w.get('hostname'): w for w in get('/orgs/$AUTOACCOUNT_ORG_ID/workloads?max_results=1000')}
reasons = []
for host in ('linux-vm', 'windows-vm'):
    wl = ws.get(host)
    if not wl:
        reasons.append(host + ' not found')
        continue
    labels = resolve_labels(wl.get('labels', []))
    if ('type', 'server') not in labels:
        reasons.append(host + \" missing Type='server'\")
    if ('dfirbubble', 'ir-cleanbubble') not in labels:
        reasons.append(host + \" missing IR='IR-CLEANBUBBLE'\")

if reasons:
    print('; '.join(reasons))
    sys.exit(1)

rulesets = get('/orgs/$AUTOACCOUNT_ORG_ID/sec_policy/draft/rule_sets')
rs = next((r for r in rulesets if (r.get('name') or '').lower() == 'task2-ringfence'), None)
if not rs:
    print('Ruleset \"Task2-Ringfence\" not found')
    sys.exit(1)

expected = {('app', 'portal'), ('env', 'production'), ('loc', 'ca'), ('type', 'server'), ('dfirbubble', 'ir-cleanbubble')}

scope_labels = set()
for scope in rs.get('scopes', []):
    for entry in scope:
        href = (entry.get('label') or {}).get('href')
        if href:
            lbl = get(href.replace('/api/v2', ''))
            scope_labels.add(((lbl.get('key') or '').lower(), (lbl.get('value') or '').lower()))

if scope_labels and scope_labels != expected:
    print('Task2-Ringfence scope should be exactly Application=portal, Environment=Production, Location=ca, Type=server, IR=IR-CLEANBUBBLE (or no scope at all), found ' + str(sorted(scope_labels)))
    sys.exit(1)
scoped_mode = bool(scope_labels)

def is_all_workloads(actors):
    return any(a.get('actors') == 'ams' for a in actors)

def is_all_services(ingress_services):
    if not ingress_services:
        return True
    for entry in ingress_services:
        href = entry.get('href')
        if href:
            svc = get(href.replace('/api/v2', ''))
            if (svc.get('name') or '').lower() == 'all services':
                return True
    return False

enabled_rules = [rule for rule in rs.get('rules', []) if rule.get('enabled', True)]
if len(enabled_rules) != 1:
    print('Task2-Ringfence should have exactly one enabled allow rule, found ' + str(len(enabled_rules)))
    sys.exit(1)

rule = enabled_rules[0]
if scoped_mode:
    src_ok = is_all_workloads(rule.get('consumers', []))
    dst_ok = is_all_workloads(rule.get('providers', []))
else:
    src_ok = resolve_labels(rule.get('consumers', [])) == expected
    dst_ok = resolve_labels(rule.get('providers', [])) == expected
svc_ok = is_all_services(rule.get('ingress_services'))

if src_ok and dst_ok and svc_ok:
    print('Both workloads have the 2 extra labels, and Task2-Ringfence ringfences the portal application correctly')
    sys.exit(0)

missing = []
if not src_ok:
    missing.append('source is wrong' + (' - should be All Workloads (inside the scope)' if scoped_mode else ' - should have all 5 labels'))
if not dst_ok:
    missing.append('destination is wrong' + (' - should be All Workloads (inside the scope)' if scoped_mode else ' - should have all 5 labels'))
if not svc_ok:
    missing.append('service should be All Services, not restricted to a specific service')
print('Task2-Ringfence has a rule but: ' + '; '.join(missing))
sys.exit(1)
")
status=$?
if [ "$status" -ne 0 ]; then
  fail-message "$result"
  exit 1
fi
echo "$result"
exit 0
