#!/bin/sh
#
# This script runs when the platform checks the challenge.
# Exit 0 = pass, non-zero = fail.
#
# FIRST DRAFT - rule shape not yet live-verified. Detail to refine.

. /root/.autoaccount_env

BASE="https://$AUTOACCOUNT_PCE_FQDN/api/v2/orgs/$AUTOACCOUNT_ORG_ID"
AUTH="api_${AUTOACCOUNT_APIKEY_ID}:${AUTOACCOUNT_APIKEY_SECRET}"
FQDN="$AUTOACCOUNT_PCE_FQDN"

result=$(python3 -c "
import json, subprocess, sys

def get(path):
    url = 'https://$FQDN/api/v2' + path
    out = subprocess.run(['curl', '-s', '-u', '$AUTH', url], capture_output=True, text=True).stdout
    return json.loads(out)

def resolve(entries):
    out = {}
    for e in entries:
        href = (e.get('label') or {}).get('href')
        if not href:
            continue
        lbl = get(href.replace('/api/v2', ''))
        out[(lbl.get('key') or '').lower()] = (lbl.get('value') or '').lower()
    return out

rulesets = get('/orgs/$AUTOACCOUNT_ORG_ID/sec_policy/draft/rule_sets')
rs = next((r for r in rulesets if (r.get('name') or '').lower() == 'task3-coreservices'), None)
if not rs:
    print('Ruleset \"Task3-CoreServices\" not found')
    sys.exit(1)

expected_providers = {'app': 'portal', 'env': 'production', 'loc': 'ca'}
for rule in rs.get('rules', []):
    providers = resolve(rule.get('providers', []))
    consumers = resolve(rule.get('consumers', []))
    if all(providers.get(k) == v for k, v in expected_providers.items()) and consumers.get('role') == 'nagios':
        print('Found the nagios -> portal allow rule in Task3-CoreServices')
        sys.exit(0)

print('Task3-CoreServices exists but has no rule allowing Role=nagios to the portal application')
sys.exit(1)
")
status=$?
if [ "$status" -ne 0 ]; then
  fail-message "$result"
  exit 1
fi
echo "$result"
exit 0
