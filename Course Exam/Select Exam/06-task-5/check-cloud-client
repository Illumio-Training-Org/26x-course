#!/bin/sh
#
# This script runs when the platform checks the challenge.
# Exit 0 = pass, non-zero = fail.
#
# FIRST DRAFT - only checks AWS onboarding + that a ruleset exists;
# doesn't yet validate the ringfence scope against real cloud resource
# labels (need a live-onboarded account to see what labels those
# resources actually get). Detail to refine.

. /root/.autoaccount_env

AUTH2="${AUTOACCOUNT_SAAPIKEY_KEYID}:${AUTOACCOUNT_SAAPIKEY_SECRET}"
BASE="https://$AUTOACCOUNT_PCE_FQDN/api/v2/orgs/$AUTOACCOUNT_ORG_ID"
AUTH="api_${AUTOACCOUNT_APIKEY_ID}:${AUTOACCOUNT_APIKEY_SECRET}"

result=$(python3 -c "
import json, subprocess, sys

cloud = subprocess.run(['curl', '-s', '-u', '$AUTH2', '-H', 'X-Tenant-Id: $AUTOACCOUNT_TENANT_ID', 'https://cloud.illum.io/api/v1/integrations'], capture_output=True, text=True).stdout
try:
    d = json.loads(cloud)
except Exception:
    print('Could not read Cloud integrations')
    sys.exit(1)
if not d.get('aws'):
    print('No AWS account onboarded yet - use Cloud -> Onboarding -> Add AWS')
    sys.exit(1)

rs = subprocess.run(['curl', '-s', '-u', '$AUTH', '$BASE/sec_policy/draft/rule_sets'], capture_output=True, text=True).stdout
rulesets = json.loads(rs)
if not any((r.get('name') or '').lower() == 'task5-cloudringfence' for r in rulesets):
    print('AWS onboarded, but ruleset \"Task5-CloudRingfence\" not found')
    sys.exit(1)

print('AWS onboarded and Task5-CloudRingfence exists')
sys.exit(0)
")
status=$?
if [ "$status" -ne 0 ]; then
  fail-message "$result"
  exit 1
fi
echo "$result"
exit 0
