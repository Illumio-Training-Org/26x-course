#!/bin/sh
#
# This script runs when the platform checks the challenge.
# Exit 0 = pass, non-zero = fail.
#
# FIRST DRAFT - checks scope only, not yet the intra-scope rule shape
# (see Task 2's note - same caveat applies). Detail to refine.

. /root/.autoaccount_env

BASE="https://$AUTOACCOUNT_PCE_FQDN/api/v2/orgs/$AUTOACCOUNT_ORG_ID"
AUTH="api_${AUTOACCOUNT_APIKEY_ID}:${AUTOACCOUNT_APIKEY_SECRET}"
FQDN="$AUTOACCOUNT_PCE_FQDN"

result=$(python3 -c "
import json, subprocess, sys

def get(path):
    url = 'https://$FQDN/api/v2' + path
    out = subprocess.run(['curl', '-s', '-u', '$AUTH', url], capture_output=True, text=True).stdout
    return json.loads(out)

rulesets = get('/orgs/$AUTOACCOUNT_ORG_ID/sec_policy/draft/rule_sets')
rs = next((r for r in rulesets if (r.get('name') or '').lower() == 'task6-ringfenceordering'), None)
if not rs:
    print('Ruleset \"Task6-RingfenceOrdering\" not found')
    sys.exit(1)

scope_labels = set()
for scope in rs.get('scopes', []):
    for entry in scope:
        href = (entry.get('label') or {}).get('href')
        if href:
            lbl = get(href.replace('/api/v2', ''))
            scope_labels.add(((lbl.get('key') or '').lower(), (lbl.get('value') or '').lower()))

expected = {('app', 'ordering'), ('env', 'development'), ('loc', 'ca')}
if not expected.issubset(scope_labels):
    print('Task6-RingfenceOrdering scope should include Application=ordering, Environment=Development, Location=ca, found ' + str(sorted(scope_labels)))
    sys.exit(1)

def is_all_workloads(actors):
    # 'All Workloads' as a source/destination is an actors:'ams' entry -
    # an ip_list (e.g. the built-in 'Any') or a specific workload/label
    # is NOT the same thing, even though a learner might reasonably
    # reach for 'Any' by mistake.
    return any(a.get('actors') == 'ams' for a in actors)

def is_all_services(ingress_services):
    # 'All Services' can be an empty ingress_services list, or a linked
    # service object whose real name is literally 'All Services' -
    # live-verified 2026-09-04 that the PCE models it as the latter
    # (a real service href), not just an empty list.
    if not ingress_services:
        return True
    for entry in ingress_services:
        href = entry.get('href')
        if href:
            svc = get(href.replace('/api/v2', ''))
            if (svc.get('name') or '').lower() == 'all services':
                return True
    return False

enabled_rules = [rule for rule in rs.get('rules', []) if rule.get('enabled', True)]
if len(enabled_rules) != 1:
    print('Task6-RingfenceOrdering should have exactly one enabled intra-scope allow rule, found ' + str(len(enabled_rules)))
    sys.exit(1)

rule = enabled_rules[0]
src_ok = is_all_workloads(rule.get('consumers', []))
dst_ok = is_all_workloads(rule.get('providers', []))
svc_ok = is_all_services(rule.get('ingress_services'))
if src_ok and dst_ok and svc_ok:
    print('Task6-RingfenceOrdering is scoped and has an intra-scope All Workloads / All Services allow rule')
    sys.exit(0)

missing = []
if not src_ok:
    missing.append('source should be All Workloads, not a specific IP list/workload/label')
if not dst_ok:
    missing.append('destination should be All Workloads, not a specific IP list/workload/label')
if not svc_ok:
    missing.append('service should be All Services, not restricted to a specific service')
print('Task6-RingfenceOrdering has a rule in scope but: ' + '; '.join(missing))
sys.exit(1)
")
status=$?
if [ "$status" -ne 0 ]; then
  fail-message "$result"
  exit 1
fi
echo "$result"
exit 0
