#!/bin/sh
#
# This script runs when the platform checks the challenge.
# Exit 0 = pass, non-zero = fail.
#
# Scopes aren't taught in the 5-day class, so the task doesn't ask for
# one by name - but a learner who already knows Scopes might still use
# one, so this accepts either: a real Scope (Application=ordering,
# Environment=Development, Location=ca) with an intra-scope All
# Workloads/All Services allow rule, or a scopeless ruleset with an
# allow rule that has the same 3 labels repeated on both source and
# destination.

. /root/.autoaccount_env

BASE="https://$AUTOACCOUNT_PCE_FQDN/api/v2/orgs/$AUTOACCOUNT_ORG_ID"
AUTH="api_${AUTOACCOUNT_APIKEY_ID}:${AUTOACCOUNT_APIKEY_SECRET}"
FQDN="$AUTOACCOUNT_PCE_FQDN"

result=$(python3 -c "
import json, subprocess, sys

def get(path):
    url = 'https://$FQDN/api/v2' + path
    out = subprocess.run(['curl', '-s', '-u', '$AUTH', url], capture_output=True, text=True).stdout
    return json.loads(out)

def resolve_labels(entries):
    out = set()
    for e in entries:
        href = (e.get('label') or {}).get('href') or e.get('href')
        if href:
            lbl = get(href.replace('/api/v2', ''))
            out.add(((lbl.get('key') or '').lower(), (lbl.get('value') or '').lower()))
    return out

rulesets = get('/orgs/$AUTOACCOUNT_ORG_ID/sec_policy/draft/rule_sets')
rs = next((r for r in rulesets if (r.get('name') or '').lower() == 'task6-ringfenceordering'), None)
if not rs:
    print('Ruleset \"Task6-RingfenceOrdering\" not found')
    sys.exit(1)

expected = {('app', 'ordering'), ('env', 'development'), ('loc', 'ca')}

scope_labels = set()
for scope in rs.get('scopes', []):
    for entry in scope:
        href = (entry.get('label') or {}).get('href')
        if href:
            lbl = get(href.replace('/api/v2', ''))
            scope_labels.add(((lbl.get('key') or '').lower(), (lbl.get('value') or '').lower()))

if scope_labels and scope_labels != expected:
    print('Task6-RingfenceOrdering scope should be exactly Application=ordering, Environment=Development, Location=ca (or no scope at all), found ' + str(sorted(scope_labels)))
    sys.exit(1)
scoped_mode = bool(scope_labels)

def is_all_workloads(actors):
    # 'All Workloads' as a source/destination is an actors:'ams' entry -
    # an ip_list (e.g. the built-in 'Any') or a specific workload/label
    # is NOT the same thing, even though a learner might reasonably
    # reach for 'Any' by mistake.
    return any(a.get('actors') == 'ams' for a in actors)

def is_all_services(ingress_services):
    # 'All Services' can be an empty ingress_services list, or a linked
    # service object whose real name is literally 'All Services' -
    # live-verified 2026-09-04 that the PCE models it as the latter
    # (a real service href), not just an empty list.
    if not ingress_services:
        return True
    for entry in ingress_services:
        href = entry.get('href')
        if href:
            svc = get(href.replace('/api/v2', ''))
            if (svc.get('name') or '').lower() == 'all services':
                return True
    return False

enabled_rules = [rule for rule in rs.get('rules', []) if rule.get('enabled', True)]
if len(enabled_rules) != 1:
    print('Task6-RingfenceOrdering should have exactly one enabled allow rule, found ' + str(len(enabled_rules)))
    sys.exit(1)

rule = enabled_rules[0]
if scoped_mode:
    src_ok = is_all_workloads(rule.get('consumers', []))
    dst_ok = is_all_workloads(rule.get('providers', []))
else:
    src_ok = resolve_labels(rule.get('consumers', [])) == expected
    dst_ok = resolve_labels(rule.get('providers', [])) == expected
svc_ok = is_all_services(rule.get('ingress_services'))
if src_ok and dst_ok and svc_ok:
    print('Task6-RingfenceOrdering ringfences the ordering application (Development, ca) correctly')
    sys.exit(0)

missing = []
if not src_ok:
    missing.append('source is wrong' + (' - should be All Workloads (inside the scope)' if scoped_mode else ' - should be Application=ordering, Environment=Development, Location=ca'))
if not dst_ok:
    missing.append('destination is wrong' + (' - should be All Workloads (inside the scope)' if scoped_mode else ' - should be Application=ordering, Environment=Development, Location=ca'))
if not svc_ok:
    missing.append('service should be All Services, not restricted to a specific service')
print('Task6-RingfenceOrdering has a rule but: ' + '; '.join(missing))
sys.exit(1)
")
status=$?
if [ "$status" -ne 0 ]; then
  fail-message "$result"
  exit 1
fi
echo "$result"
exit 0
