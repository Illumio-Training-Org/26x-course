#!/bin/sh
#
# This script runs when the platform checks the challenge.
# Exit 0 = pass, non-zero = fail.
#
# Fixed 2026-09-08: Nathan reported no feedback at all when the deny
# rule was created but the SSH allow rule was missing. The logic
# already had a message for that case, but the shell wrapper below
# only captures stdout - if any get()/resolve() call hit an
# unexpected response (a transient auth blip, a stale href, anything
# not shaped like expected JSON), Python would crash with a traceback
# on stderr, $result would end up empty, and fail-message "" shows the
# learner nothing - indistinguishable from "no feedback" regardless of
# the real cause. Wrapped the whole check in try/except so a crash
# always surfaces *something* instead of failing silently.
#
# Fixed 2026-09-10: the deny-rule check only ever said "Dev->Prod deny
# rule is missing" even when a deny rule existed but was missing a
# single label (e.g. App=ordering) - live-caught by Nathan. Now tracks
# the closest-matching deny rule across the ruleset's deny_rules and
# reports exactly which label(s) on which side are wrong or missing.
#
# Fixed 2026-09-11: neither the deny rule nor the SSH allow rule
# rejected extra labels (e.g. Location=ca added to both sides) - this
# task's rules are meant to be location-agnostic, so an extra Location
# label wrongly narrows their scope and should fail - live-caught by
# Nathan. Both now reject any extra label, and the SSH allow-rule
# check reports specific reasons the same way the deny-rule check
# already did.

. /root/.autoaccount_env

BASE="https://$AUTOACCOUNT_PCE_FQDN/api/v2/orgs/$AUTOACCOUNT_ORG_ID"
AUTH="api_${AUTOACCOUNT_APIKEY_ID}:${AUTOACCOUNT_APIKEY_SECRET}"
FQDN="$AUTOACCOUNT_PCE_FQDN"

result=$(python3 -c "
import json, subprocess, sys, traceback

def get(path):
    url = 'https://$FQDN/api/v2' + path
    out = subprocess.run(['curl', '-s', '-u', '$AUTH', url], capture_output=True, text=True).stdout
    return json.loads(out)

def resolve(entries):
    out = {}
    for e in entries:
        href = (e.get('label') or {}).get('href')
        if not href:
            continue
        lbl = get(href.replace('/api/v2', ''))
        out[(lbl.get('key') or '').lower()] = (lbl.get('value') or '').lower()
    return out

def service_names(ingress_services):
    names = set()
    for entry in ingress_services or []:
        href = entry.get('href')
        if href:
            svc = get(href.replace('/api/v2', ''))
            n = (svc.get('name') or '').lower()
            if n:
                names.add(n)
    return names

def is_all_services(ingress_services):
    # 'All Services' can be an empty ingress_services list, or a linked
    # service object whose real name is literally 'All Services' - see
    # Task 6/7's check for the same live-verified behavior.
    if not ingress_services:
        return True
    return 'all services' in service_names(ingress_services)

def is_ssh_only(ingress_services):
    if not ingress_services or is_all_services(ingress_services):
        return False
    return any('ssh' in n for n in service_names(ingress_services))

def side_problems(name, found, expected):
    probs = []
    for key, want in expected.items():
        got = found.get(key)
        if got != want:
            probs.append(name + ' ' + key + ' should be ' + want + ', found ' + (got or 'missing'))
    extra = set(found) - set(expected)
    if extra:
        probs.append(name + ' has unexpected extra label(s): ' + ', '.join(sorted(extra)))
    return probs

def run():
    rulesets = get('/orgs/$AUTOACCOUNT_ORG_ID/sec_policy/draft/rule_sets')
    rs = next((r for r in rulesets if (r.get('name') or '').lower() == 'task8-denyglobal'), None)
    if not rs:
        print('Policy \"Task8-DenyGlobal\" not found')
        sys.exit(1)

    expected_consumer = {'app': 'ordering', 'env': 'development'}
    expected_provider = {'app': 'ordering', 'env': 'production'}

    dev_to_prod = False
    dev_to_prod_all_services = False
    best_deny_reasons = None
    deny_rules = rs.get('deny_rules', [])
    for dr in deny_rules:
        consumers = resolve(dr.get('consumers', []))
        providers = resolve(dr.get('providers', []))
        reasons = side_problems('source', consumers, expected_consumer) + side_problems('destination', providers, expected_provider)
        if not reasons and is_all_services(dr.get('ingress_services')):
            dev_to_prod = True
            dev_to_prod_all_services = True
            best_deny_reasons = []
            break
        if not reasons:
            reasons = ['deny rule should cover All Services, not a specific service']
        if best_deny_reasons is None or len(reasons) < len(best_deny_reasons):
            best_deny_reasons = reasons

    ssh_dev_to_prod = False
    best_ssh_reasons = None
    enabled_rules = [rule for rule in rs.get('rules', []) if rule.get('enabled', True)]
    for rule in enabled_rules:
        consumers = resolve(rule.get('consumers', []))
        providers = resolve(rule.get('providers', []))
        reasons = side_problems('source', consumers, expected_consumer) + side_problems('destination', providers, expected_provider)
        if not reasons and is_ssh_only(rule.get('ingress_services')):
            ssh_dev_to_prod = True
            best_ssh_reasons = []
            break
        if not reasons:
            reasons = ['should permit only SSH, not All Services or a different specific service']
        if best_ssh_reasons is None or len(reasons) < len(best_ssh_reasons):
            best_ssh_reasons = reasons

    missing = []
    if not (dev_to_prod and dev_to_prod_all_services):
        if not deny_rules:
            missing.append('Dev->Prod deny rule is missing')
        else:
            missing.append('Dev->Prod deny rule is close but: ' + '; '.join(best_deny_reasons))
    if not ssh_dev_to_prod:
        if not enabled_rules:
            missing.append('missing an Allow Rule permitting SSH from Development to Production for ordering')
        else:
            missing.append('SSH allow rule is close but: ' + '; '.join(best_ssh_reasons))

    if not missing:
        print('Found Dev->Prod deny (All Services) for ordering, plus an SSH allow rule')
        sys.exit(0)

    print('Task8-DenyGlobal: ' + '; '.join(missing))
    sys.exit(1)

try:
    run()
except SystemExit:
    raise
except Exception:
    print('Task8-DenyGlobal check hit an unexpected error (not a problem with your policy) - please try Check again. Details: ' + traceback.format_exc().splitlines()[-1])
    sys.exit(1)
")
status=$?
if [ "$status" -ne 0 ]; then
  fail-message "$result"
  exit 1
fi
echo "$result"
exit 0
