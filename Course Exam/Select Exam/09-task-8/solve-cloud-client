#!/bin/sh
#
# Runs when the learner clicks Skip. Creates the dev-prod Label Group
# and updates Task7-RingfenceOrdering's scope to use it, replacing the
# single Development label - no-ops if Task 7's ruleset doesn't exist
# yet (run its own solve/skip first).
#
# FIRST DRAFT - detail to be refined.

. /root/.autoaccount_env

AUTH="api_${AUTOACCOUNT_APIKEY_ID}:${AUTOACCOUNT_APIKEY_SECRET}"
FQDN="$AUTOACCOUNT_PCE_FQDN"

python3 -c "
import json, subprocess

def call(method, path, body=None):
    cmd = ['curl', '-s', '-u', '$AUTH', '-X', method, 'https://$FQDN/api/v2' + path]
    if body is not None:
        cmd += ['-H', 'Content-Type: application/json', '-d', json.dumps(body)]
    out = subprocess.run(cmd, capture_output=True, text=True).stdout
    try:
        return json.loads(out)
    except Exception:
        return None

def find_or_create_label(key, value):
    labels = call('GET', '/orgs/\$AUTOACCOUNT_ORG_ID/labels?max_results=1000') or []
    for l in labels:
        if l.get('key') == key and (l.get('value') or '').lower() == value.lower():
            return l['href']
    created = call('POST', '/orgs/\$AUTOACCOUNT_ORG_ID/labels', {'key': key, 'value': value})
    return created['href'] if created else None

dev_href = find_or_create_label('env', 'Development')
prod_href = find_or_create_label('env', 'Production')

label_groups = call('GET', '/orgs/\$AUTOACCOUNT_ORG_ID/sec_policy/draft/label_groups') or []
lg = next((g for g in label_groups if (g.get('name') or '').lower() == 'dev-prod'), None)
if not lg:
    lg = call('POST', '/orgs/\$AUTOACCOUNT_ORG_ID/sec_policy/draft/label_groups', {
        'name': 'dev-prod',
        'key': 'env',
        'labels': [{'href': dev_href}, {'href': prod_href}],
    })

rulesets = call('GET', '/orgs/\$AUTOACCOUNT_ORG_ID/sec_policy/draft/rule_sets') or []
rs = next((r for r in rulesets if (r.get('name') or '').lower() == 'task7-ringfenceordering'), None)
if rs and lg:
    app_href = find_or_create_label('app', 'ordering')
    loc_href = find_or_create_label('loc', 'ca')
    call('PUT', rs['href'], {
        'scopes': [[
            {'label': {'href': app_href}},
            {'label_group': {'href': lg['href']}},
            {'label': {'href': loc_href}},
        ]],
    })
"

exit 0
