#!/bin/sh
#
# This script runs when the platform checks the challenge.
# Exit 0 = pass, non-zero = fail.

. /root/.autoaccount_env

BASE="https://$AUTOACCOUNT_PCE_FQDN/api/v2/orgs/$AUTOACCOUNT_ORG_ID"
AUTH="api_${AUTOACCOUNT_APIKEY_ID}:${AUTOACCOUNT_APIKEY_SECRET}"
FQDN="$AUTOACCOUNT_PCE_FQDN"

result=$(python3 -c "
import json, subprocess, sys

def get(path):
    url = 'https://$FQDN/api/v2' + path
    out = subprocess.run(['curl', '-s', '-u', '$AUTH', url], capture_output=True, text=True).stdout
    return json.loads(out)

def resolve(entries):
    out = {}
    for e in entries:
        href = (e.get('label') or {}).get('href')
        if not href:
            continue
        lbl = get(href.replace('/api/v2', ''))
        out[(lbl.get('key') or '').lower()] = (lbl.get('value') or '').lower()
    return out

rulesets = get('/orgs/$AUTOACCOUNT_ORG_ID/sec_policy/draft/rule_sets')
rs = next((r for r in rulesets if (r.get('name') or '').lower() == 'task9-denyglobal'), None)
if not rs:
    print('Ruleset \"Task9-DenyGlobal\" not found')
    sys.exit(1)

dev_to_prod = False
prod_to_dev = False
for dr in rs.get('deny_rules', []):
    consumers = resolve(dr.get('consumers', []))
    providers = resolve(dr.get('providers', []))
    if consumers.get('app') == 'ordering' and providers.get('app') == 'ordering':
        if consumers.get('env') == 'development' and providers.get('env') == 'production':
            dev_to_prod = True
        if consumers.get('env') == 'production' and providers.get('env') == 'development':
            prod_to_dev = True

if dev_to_prod and prod_to_dev:
    print('Found both Dev->Prod and Prod->Dev deny rules for ordering (global)')
    sys.exit(0)

missing = []
if not dev_to_prod:
    missing.append('Dev->Prod')
if not prod_to_dev:
    missing.append('Prod->Dev')
print('Task9-DenyGlobal is missing: ' + ', '.join(missing))
sys.exit(1)
")
status=$?
if [ "$status" -ne 0 ]; then
  fail-message "$result"
  exit 1
fi
echo "$result"
exit 0
