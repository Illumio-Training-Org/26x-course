#!/bin/sh
#
# Runs when the learner clicks Skip. Creates the Payment/LDN labels
# (didn't exist in the org's pre-seeded content, confirmed 2026-09-02)
# and Task9-RingfencePayment as a scopeless ruleset with an allow rule
# that has Application=Payment, Location=LDN on both source and
# destination - the realistic answer given Scopes aren't taught in the
# 5-day class. check-cloud-client also accepts the Scope-based
# equivalent for a learner who already knows Scopes.

. /root/.autoaccount_env

AUTH="api_${AUTOACCOUNT_APIKEY_ID}:${AUTOACCOUNT_APIKEY_SECRET}"
FQDN="$AUTOACCOUNT_PCE_FQDN"

python3 -c "
import json, subprocess

def call(method, path, body=None):
    cmd = ['curl', '-s', '-u', '$AUTH', '-X', method, 'https://$FQDN/api/v2' + path]
    if body is not None:
        cmd += ['-H', 'Content-Type: application/json', '-d', json.dumps(body)]
    out = subprocess.run(cmd, capture_output=True, text=True).stdout
    try:
        return json.loads(out)
    except Exception:
        return None

def find_or_create_label(key, value):
    labels = call('GET', '/orgs/$AUTOACCOUNT_ORG_ID/labels?max_results=1000') or []
    for l in labels:
        if l.get('key') == key and (l.get('value') or '').lower() == value.lower():
            return l['href']
    created = call('POST', '/orgs/$AUTOACCOUNT_ORG_ID/labels', {'key': key, 'value': value})
    return created['href'] if created else None

def find_all_services_href():
    services = call('GET', '/orgs/$AUTOACCOUNT_ORG_ID/sec_policy/draft/services?max_results=1000') or []
    for s in services:
        if (s.get('name') or '').lower() == 'all services':
            return s['href']
    return None

app_href = find_or_create_label('app', 'Payment')
loc_href = find_or_create_label('loc', 'LDN')
all_services_href = find_all_services_href()

rulesets = call('GET', '/orgs/$AUTOACCOUNT_ORG_ID/sec_policy/draft/rule_sets?max_results=1000') or []
rs = next((r for r in rulesets if (r.get('name') or '').lower() == 'task9-ringfencepayment'), None)
if not rs:
    rs = call('POST', '/orgs/$AUTOACCOUNT_ORG_ID/sec_policy/draft/rule_sets', {
        'name': 'Task9-RingfencePayment',
        'scopes': [[]],
    })

if rs and rs.get('href'):
    existing_rules = rs.get('rules', [])
    if not any(rule.get('enabled', True) for rule in existing_rules):
        call('POST', rs['href'] + '/sec_rules', {
            'enabled': True,
            'providers': [{'label': {'href': app_href}}, {'label': {'href': loc_href}}],
            'consumers': [{'label': {'href': app_href}}, {'label': {'href': loc_href}}],
            'ingress_services': [{'href': all_services_href}] if all_services_href else [],
            'resolve_labels_as': {'providers': ['workloads'], 'consumers': ['workloads']},
        })
"

exit 0
