#!/bin/sh
#
# Runs when the learner clicks Skip. Changes linux-vm's DFIRBubble
# label from IR-CLEANBUBBLE to IR-DIRTYBUBBLE (creating the label if
# it doesn't exist yet). No-ops if not paired yet.
#
# Live-verified 2026-09-07 (org 4138910): a workload's existing
# `labels` entries come back from GET with `key`/`value` resolved
# inline, but PUT's schema only allows `{href}` on each entry - sending
# them straight back caused a 406 ("contains additional properties
# [key, value]"), so the whole label update silently failed (this is
# what a learner hit on Skip). Fixed by stripping existing entries down
# to `{href}` before re-sending.

. /root/.autoaccount_env

AUTH="api_${AUTOACCOUNT_APIKEY_ID}:${AUTOACCOUNT_APIKEY_SECRET}"
FQDN="$AUTOACCOUNT_PCE_FQDN"

python3 -c "
import json, subprocess

def call(method, path, body=None):
    cmd = ['curl', '-s', '-u', '$AUTH', '-X', method, 'https://$FQDN/api/v2' + path]
    if body is not None:
        cmd += ['-H', 'Content-Type: application/json', '-d', json.dumps(body)]
    out = subprocess.run(cmd, capture_output=True, text=True).stdout
    try:
        return json.loads(out)
    except Exception:
        return None

def find_or_create_label(key, value):
    labels = call('GET', '/orgs/$AUTOACCOUNT_ORG_ID/labels?max_results=1000') or []
    for l in labels:
        if l.get('key') == key and (l.get('value') or '').lower() == value.lower():
            return l['href']
    created = call('POST', '/orgs/$AUTOACCOUNT_ORG_ID/labels', {'key': key, 'value': value})
    return created['href'] if created else None

dirty_href = find_or_create_label('DFIRBubble', 'IR-DIRTYBUBBLE')

ws = call('GET', '/orgs/$AUTOACCOUNT_ORG_ID/workloads?max_results=1000') or []
wl = next((w for w in ws if w.get('hostname') == 'linux-vm'), None)

if wl and dirty_href:
    label_cache = {}
    kept = []
    for l in wl.get('labels', []):
        href = l.get('href')
        if not href:
            continue
        if href not in label_cache:
            label_cache[href] = call('GET', href.replace('/api/v2', '')) or {}
        key = (label_cache[href].get('key') or '').lower()
        if key != 'dfirbubble':
            kept.append({'href': href})
    call('PUT', wl['href'], {'labels': kept + [{'href': dirty_href}]})
"

exit 0
