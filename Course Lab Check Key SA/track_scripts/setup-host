#!/bin/sh
set -ex

echo "===== k3s/Cilium bootstrap START ====="

# Deploy Cilium as the CNI (image ships the binary, but install still has
# to run against this specific cluster instance). Firewall coexistence is
# deliberately NOT configured here - that's a hands-on learner task in
# Challenge 4 (checking status and configuring coexistence themselves).
cilium install --version 1.18.6
cilium hubble enable

# Pre-pull the CVEN storage (etcd) image so the learner's helm install
# never pulls it from Docker Hub, whose anonymous limit (429 Too Many
# Requests) is hit when a class installs at once - Instruqt VMs share
# egress IPs. Google's Docker Hub mirror first, Docker Hub as fallback;
# tagged under the docker.io name the chart asks for (IfNotPresent).
# Tag matches chart 5.6.1 (storage.registry/repo/imageTag) - update both
# together. Never fails the boot: the learner can still pull it.
ETCD=bitnamilegacy/etcd:3.6.4
for i in 1 2 3; do
  for SRC in mirror.gcr.io/$ETCD docker.io/$ETCD; do
    if k3s ctr -n k8s.io images pull "$SRC" >/dev/null 2>&1; then
      [ "$SRC" = "docker.io/$ETCD" ] || k3s ctr -n k8s.io images tag --force "$SRC" "docker.io/$ETCD" || true
      echo "CVEN storage image pre-pulled from $SRC"
      break 2
    fi
  done
  sleep 10
done

# Shorthand for the learner's console
echo "alias k=kubectl" >> /root/.bashrc

echo "===== k3s/Cilium bootstrap END ====="
