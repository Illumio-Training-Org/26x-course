# ---------------------------------------
# PROJECT CRYSTAL TRAFFIC GENERATION
# ---------------------------------------
# Replaces vensim for this lab variant. Project Crystal creates a new
# deployment via its own REST API (using CRYSTAL_API_KEY, a team-level
# Instruqt secret - not tenant-specific), binds it live to THIS
# sandbox's own freshly-provisioned PCE org (the AUTOACCOUNT_* values
# below), applies the built-in "default" vensim-style template, and
# starts it. See github.com/justinvid/pc-connector for the module
# source - main.tf does 4 API calls: POST /api/deployments, PUT
# .../config, POST .../vensim-template, POST .../start.

# Install Terraform
# apt-key is removed on this image's Debian version (trixie) - use the
# modern keyring-file method instead of the colleague's original
# apt-key add call.
curl -fsSL https://apt.releases.hashicorp.com/gpg | gpg --dearmor -o /usr/share/keyrings/hashicorp-archive-keyring.gpg
echo "deb [signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com $(lsb_release -cs) main" > /etc/apt/sources.list.d/hashicorp.list
apt-get update -y
apt-get -y install terraform

# Command echoing (set -x) is switched off for the whole Crystal block
# below, because every curl here carries CRYSTAL_API_KEY - a shared,
# team-level secret - and xtrace would print it into the Instruqt
# track logs. Progress is still logged via the echo lines. Switched
# back on after the attack is fired.
set +x
echo "--- Crystal block start (command echo off to keep the API key out of logs) ---"

CRYSTAL_BASE_URL="https://crystal.illumio.com"
TEMPLATE_NAME="default"

# Diagnostics: confirm this sandbox container can actually reach
# Crystal before handing off to terraform, since terraform's own
# error on a network-level failure is an opaque "context deadline
# exceeded" with no detail on which stage (DNS/TCP/TLS) failed.
echo "--- Crystal reachability diagnostics ---"
getent hosts crystal.illumio.com || echo "DNS resolution FAILED for crystal.illumio.com"
# -w timings instead of -v: -v prints request headers, including the
# API key. Zero connect/tls time shows which stage failed.
curl -sS --connect-timeout 5 -m 8 -o /dev/null \
  -w "HTTP %{http_code} dns=%{time_namelookup}s connect=%{time_connect}s tls=%{time_appconnect}s\n" \
  -H "X-API-Key: $CRYSTAL_API_KEY" "$CRYSTAL_BASE_URL/api/deployments" || echo "curl exit code: $?"
echo "--- end diagnostics ---"
reach_code="$(curl -s -o /dev/null -m 8 -w "%{http_code}" -H "X-API-Key: $CRYSTAL_API_KEY" "$CRYSTAL_BASE_URL/api/deployments" || echo 000)"
[ "$reach_code" = "200" ] && echo "CHECK-OK: crystal-reachable" || echo "CHECK-FAIL: crystal-reachable (HTTP $reach_code)"

