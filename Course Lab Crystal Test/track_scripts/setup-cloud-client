CHECKEOF
chmod +x /usr/local/bin/check-cloud

# ---------------------------------------
# PROJECT CRYSTAL TRAFFIC GENERATION
# ---------------------------------------
# Replaces vensim for this lab variant. Project Crystal creates a new
# deployment via its own REST API (using CRYSTAL_API_KEY, a team-level
# Instruqt secret - not tenant-specific), binds it live to THIS
# sandbox's own freshly-provisioned PCE org (the AUTOACCOUNT_* values
# below), applies the built-in "default" vensim-style template, and
# starts it. See github.com/justinvid/pc-connector for the module
# source - main.tf does 4 API calls: POST /api/deployments, PUT
# .../config, POST .../vensim-template, POST .../start.

# Install Terraform
# apt-key is removed on this image's Debian version (trixie) - use the
# modern keyring-file method instead of the colleague's original
# apt-key add call.
curl -fsSL https://apt.releases.hashicorp.com/gpg | gpg --dearmor -o /usr/share/keyrings/hashicorp-archive-keyring.gpg
echo "deb [signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com $(lsb_release -cs) main" > /etc/apt/sources.list.d/hashicorp.list
apt-get update -y
apt-get -y install terraform

CRYSTAL_BASE_URL="https://crystal.illumio.com"
TEMPLATE_NAME="default"

# Diagnostics: confirm this sandbox container can actually reach
# Crystal before handing off to terraform, since terraform's own
# error on a network-level failure is an opaque "context deadline
# exceeded" with no detail on which stage (DNS/TCP/TLS) failed.
echo "--- Crystal reachability diagnostics ---"
getent hosts crystal.illumio.com || echo "DNS resolution FAILED for crystal.illumio.com"
curl -v --connect-timeout 5 -m 8 -o /dev/null -w "HTTP %{http_code}\n" \
  -H "X-API-Key: $CRYSTAL_API_KEY" "$CRYSTAL_BASE_URL/api/deployments" || echo "curl exit code: $?"
echo "--- end diagnostics ---"

# Deployment naming: <track_slug>_<DDMMYY>_<XX>, XX incrementing per
# track per day (e.g. 26x_lab_crystal_test_220926_01). No atomic
# counter service exists to make this race-proof against many
# learners starting at once (up to ~15 concurrent sessions expected),
# so this adds a random jitter delay plus a check-and-retry loop
# rather than a naive "count existing, +1" - reduces collisions
# without guaranteeing zero, since Crystal deployments are keyed by
# their own UUID, not name, so a collision would only ever be
# cosmetic, never functionally broken.
TRACK_SLUG_CLEAN="${INSTRUQT_TRACK_SLUG//-/_}"
DATE_STR="$(date -u +%d%m%y)"
NAME_PREFIX="${TRACK_SLUG_CLEAN}_${DATE_STR}_"

sleep "0.$((RANDOM % 900 + 100))"

DEPLOYMENT_NAME=""
for attempt in 1 2 3 4 5; do
  EXISTING_NAMES="$(curl -s -H "X-API-Key: $CRYSTAL_API_KEY" "$CRYSTAL_BASE_URL/api/deployments" | python3 -c "
import json, sys
prefix = '$NAME_PREFIX'
print('\n'.join(d.get('name','') for d in json.load(sys.stdin) if d.get('name','').startswith(prefix)))
" 2>/dev/null)"
  NEXT_NUM=$(printf "%02d" $(( $(echo "$EXISTING_NAMES" | grep -c "^${NAME_PREFIX}") + attempt )))
  CANDIDATE="${NAME_PREFIX}${NEXT_NUM}"
  if ! echo "$EXISTING_NAMES" | grep -qx "$CANDIDATE"; then
    DEPLOYMENT_NAME="$CANDIDATE"
    break
  fi
  sleep "0.$((RANDOM % 500 + 200))"
done
[ -z "$DEPLOYMENT_NAME" ] && DEPLOYMENT_NAME="${NAME_PREFIX}${AUTOACCOUNT_ORG_ID}"

cd ~
git clone https://github.com/justinvid/pc-connector.git
cd ~/pc-connector/
terraform init
terraform apply -auto-approve -input=false \
  -var "crystal_api_key=$CRYSTAL_API_KEY" \
  -var "crystal_base_url=$CRYSTAL_BASE_URL" \
  -var "pce_api_user=api_${AUTOACCOUNT_APIKEY_ID}" \
  -var "pce_api_secret=$AUTOACCOUNT_APIKEY_SECRET" \
  -var "org_id=$AUTOACCOUNT_ORG_ID" \
  -var "name=$DEPLOYMENT_NAME" \
  -var "template_name=$TEMPLATE_NAME" \
  -var "pce_fqdn=$pceFqdn"

CRYSTAL_DEPLOYMENT_ID="$(terraform output -raw deployment_id)"
agent variable set CRYSTALDEPLOYMENT "$CRYSTAL_DEPLOYMENT_ID"
agent variable set CRYSTALBASEURL "$CRYSTAL_BASE_URL"

# The module's own start_request fires immediately after
# template_request with no delay, but the CSV/object import behind
# the template takes a few seconds to actually finish on Crystal's
# backend - calling /start that fast returns 200 but silently doesn't
# launch anything (confirmed live: same call worked once retried a
# few minutes later). Poll status and retry /start until it's
# actually running, rather than trusting the first 200.
for i in 1 2 3 4 5 6; do
  status="$(curl -s -H "X-API-Key: $CRYSTAL_API_KEY" "$CRYSTAL_BASE_URL/api/deployments/$CRYSTAL_DEPLOYMENT_ID" | python3 -c "import json,sys; print(json.load(sys.stdin).get('status'))")"
  if [ "$status" = "running" ]; then
    echo "Crystal deployment is running (attempt $i)"
    break
  fi
  echo "Crystal deployment status is '$status' (attempt $i) - retrying /start"
  curl -s -o /dev/null -X POST -H "X-API-Key: $CRYSTAL_API_KEY" -H "Content-Type: application/json" \
    -d '{"interval":"5m","auto_attacks":false}' \
    "$CRYSTAL_BASE_URL/api/deployments/$CRYSTAL_DEPLOYMENT_ID/start"
  sleep 10
done

echo "===== MAGIC LINK + ACCOUNT SETUP END ====="
