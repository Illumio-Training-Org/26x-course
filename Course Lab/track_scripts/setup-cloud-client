#!/bin/bash
set -exo

echo "===== MAGIC LINK + ACCOUNT SETUP START ====="
date

# ---------------------------------------
# Ensure required tools are present and updated
# ---------------------------------------

# update package index only
apt-get update -y

# upgrade only existing core tools (no installs)
apt-get install --only-upgrade -y curl git


# Command echoing (set -x) is off from here until the tile is rendered:
# this section handles the learner's API secrets and magic link (a
# login URL for their PCE org), and xtrace would print them all into
# the Instruqt track logs. Values stay available via agent variables.
set +x

# ---------------------------------------
# Sanitize AUTOACCOUNT_* values
# ---------------------------------------
# Instruqt's autoaccount custom resource emits these as JSON-array-literal
# strings (e.g. '["value"]') even with account_count: 1, not bare scalars.
# AUTOACCOUNT_MAGICLINK already got this same tr -d treatment further
# below; extend it to every other AUTOACCOUNT_* value up front so nothing
# downstream (the PCE FQDN split, the agent variables, or the vensim
# block) parses a value with stray brackets/quotes still in it.
for var in AUTOACCOUNT_TENANT_ID AUTOACCOUNT_APIKEY_ID AUTOACCOUNT_APIKEY_SECRET \
           AUTOACCOUNT_ORG_ID AUTOACCOUNT_PCE_FQDN AUTOACCOUNT_SAAPIKEY_KEYID \
           AUTOACCOUNT_SAAPIKEY_SECRET; do
  cleaned="$(echo "${!var}" | tr -d '{}[]"')"
  export "$var=$cleaned"
done

# Also make the cleaned values visible to any new terminal tab the
# learner opens (e.g. the Advanced "echo $AUTOACCOUNT_APIKEY_ID" step) —
# the container's own injected env vars are still the raw/dirty ones, so
# override them for every future interactive shell via .bashrc.
{
  for var in AUTOACCOUNT_TENANT_ID AUTOACCOUNT_APIKEY_ID AUTOACCOUNT_APIKEY_SECRET \
             AUTOACCOUNT_ORG_ID AUTOACCOUNT_PCE_FQDN AUTOACCOUNT_SAAPIKEY_KEYID \
             AUTOACCOUNT_SAAPIKEY_SECRET; do
    printf 'export %s=%q\n' "$var" "${!var}"
  done
} >> /root/.bashrc

# Deliberately NOT exporting CRYSTAL_API_KEY into .bashrc the way the
# AUTOACCOUNT_* values above are. Unlike those (each scoped to one
# learner's own single-use, ephemeral PCE org), CRYSTAL_API_KEY is a
# single team-level secret shared across every learner session - if
# it were exposed to an interactive shell, any learner could extract
# it and get full account-wide Crystal access (list/create/stop/
# delete any deployment for the whole team) from outside the sandbox
# entirely. It stays available only within this script's own process,
# which is all it's actually needed for.

# ---------------------------------------
# Parse PCE FQDN
# ---------------------------------------
if [[ "$AUTOACCOUNT_PCE_FQDN" == *:* ]]; then
  pceFqdn=${AUTOACCOUNT_PCE_FQDN%%:*}
  pcePort=${AUTOACCOUNT_PCE_FQDN##*:}
else
  echo "ERROR: AUTOACCOUNT_PCE_FQDN does not contain a port."
  exit 1
fi

# ---------------------------------------
# Save variables for later use (Instruqt state)
# ---------------------------------------
agent variable set ACCOUNTID "$AUTOACCOUNT_TENANT_ID"
agent variable set APINAME "api_${AUTOACCOUNT_APIKEY_ID}"
agent variable set APISECRET "$AUTOACCOUNT_APIKEY_SECRET"
agent variable set ORGID "$AUTOACCOUNT_ORG_ID"
agent variable set PCEFQDN "$pceFqdn"
agent variable set PCEPort "$pcePort"
agent variable set SACLIENT "$AUTOACCOUNT_SAAPIKEY_KEYID"
agent variable set SASECRET "$AUTOACCOUNT_SAAPIKEY_SECRET"

# ---------------------------------------
# MAGIC LINK SETUP
# ---------------------------------------
MAGIC_LINK=$(echo "${AUTOACCOUNT_MAGICLINK}" | tr -d '{}[]"')

echo "Magic link generated (not printed, to keep it out of the logs)"

# ---------------------------------------
# Save MAGIC LINK (Instruqt state)
# ---------------------------------------
agent variable set MAGICURL "$MAGIC_LINK"
# Markers ("CHECK-OK: <step>" / "CHECK-FAIL: <step>") are read by the
# pre-class quick check in CX-NEW/Verify Labs - keep the wording stable.
[ -n "$MAGIC_LINK" ] && echo "CHECK-OK: magic-link" || echo "CHECK-FAIL: magic-link"

# ---------------------------------------
# Render tile (gomplate) - unchanged source repo, per Nathan's instruction
# ---------------------------------------
git clone https://github.com/jdschmitz15/illumio-instruqt-terraform-template.git
AUTOACCOUNT_MAGICLINK="$MAGIC_LINK"
gomplate -f ~/illumio-instruqt-terraform-template/index.html.tmpl -o /var/www/html/index.html
# The tile's <img> points at /assets/Illumio_Glyph_Orange_RGB.png, but the
# template repo keeps that file at its root, so the tile showed the alt text "icon".
mkdir -p /var/www/html/assets
cp ~/illumio-instruqt-terraform-template/Illumio_Glyph_Orange_RGB.png /var/www/html/assets/
set -x
date

# ---------------------------------------
# SELF-CHECK SCRIPTS
# ---------------------------------------
# Pre-staged so the assignment's "Check your work" steps are a single
# clean command instead of a big inline curl/python block.

cat > /usr/local/bin/check-workloads << 'CHECKEOF'
