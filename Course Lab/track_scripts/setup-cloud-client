# ---------------------------------------
# DISABLE ALL RULESETS (lab start state)
# ---------------------------------------
# Learners must start with every ruleset disabled - they enable "15. IR"
# themselves during the IR exercise. Crystal's "default" template creates
# its rulesets enabled, but imports them asynchronously a few minutes
# AFTER this setup script finishes, so this runs as a background job:
# waits until the import looks done (>=100 labels and a ruleset count
# that hasn't changed for 3 checks, every 20s, up to 30 min), then
# disables every enabled ruleset in DRAFT only (no provision - Nathan's
# call), re-checking at +5 and +10 min for any late-arriving rulesets.
# Log: /var/log/disable-all-rulesets.log
cat > /usr/local/bin/disable-all-rulesets << 'DISABLEEOF'
#!/usr/bin/env python3
import json, os, subprocess, time
base = "https://" + os.environ["AUTOACCOUNT_PCE_FQDN"] + "/api/v2"
org = "/orgs/" + os.environ["AUTOACCOUNT_ORG_ID"]
auth = "api_" + os.environ["AUTOACCOUNT_APIKEY_ID"] + ":" + os.environ["AUTOACCOUNT_APIKEY_SECRET"]

def call(method, path, body=None):
    cmd = ["curl", "-s", "-m", "60", "-u", auth, "-X", method, base + path]
    if body is not None:
        cmd += ["-H", "Content-Type: application/json", "-d", json.dumps(body)]
    out = subprocess.run(cmd, capture_output=True, text=True).stdout
    try:
        return json.loads(out)
    except Exception:
        return out

def count(path):
    r = call("GET", org + path)
    return len(r) if isinstance(r, list) else 0

history = []
for i in range(90):
    labels, rulesets = count("/labels?max_results=1000"), count("/sec_policy/draft/rule_sets?max_results=1000")
    print(time.strftime("%H:%M:%S"), "labels", labels, "rulesets", rulesets, flush=True)
    history.append(rulesets)
    if labels >= 100 and rulesets >= 10 and len(history) >= 3 and len(set(history[-3:])) == 1:
        break
    time.sleep(20)
else:
    print("WARNING: Crystal import did not look complete after 30 min - continuing anyway", flush=True)

def disable_all():
    for rs in call("GET", org + "/sec_policy/draft/rule_sets?max_results=1000") or []:
        if isinstance(rs, dict) and rs.get("enabled") and rs.get("href"):
            call("PUT", rs["href"], {"enabled": False})
            print(time.strftime("%H:%M:%S"), "Disabled:", rs.get("name"), flush=True)

disable_all()
for wait in (300, 300):
    time.sleep(wait)
    disable_all()
print("Disable all rulesets done", flush=True)
DISABLEEOF
chmod +x /usr/local/bin/disable-all-rulesets

