# ---------------------------------------
# PROJECT CRYSTAL TRAFFIC GENERATION
# ---------------------------------------
# Replaces vensim for this lab variant. Project Crystal creates a new
# deployment via its own REST API (using CRYSTAL_API_KEY, a team-level
# Instruqt secret - not tenant-specific), binds it live to THIS
# sandbox's own freshly-provisioned PCE org (the AUTOACCOUNT_* values
# below), applies the built-in "default" vensim-style template, and
# starts it. See github.com/justinvid/pc-connector for the module
# source - main.tf does 4 API calls: POST /api/deployments, PUT
# .../config, POST .../vensim-template, POST .../start.

# Install Terraform
# apt-key is removed on this image's Debian version (trixie) - use the
# modern keyring-file method instead of the colleague's original
# apt-key add call.
curl -fsSL https://apt.releases.hashicorp.com/gpg | gpg --dearmor -o /usr/share/keyrings/hashicorp-archive-keyring.gpg
echo "deb [signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com $(lsb_release -cs) main" > /etc/apt/sources.list.d/hashicorp.list
apt-get update -y
apt-get -y install terraform

# Command echoing (set -x) is switched off for the whole Crystal block
# below, because every curl here carries CRYSTAL_API_KEY - a shared,
# team-level secret - and xtrace would print it into the Instruqt
# track logs. Progress is still logged via the echo lines. Switched
# back on after the attack is fired.
set +x
echo "--- Crystal block start (command echo off to keep the API key out of logs) ---"

CRYSTAL_BASE_URL="https://crystal.illumio.com"
TEMPLATE_NAME="default"

# Diagnostics: confirm this sandbox container can actually reach
# Crystal before handing off to terraform, since terraform's own
# error on a network-level failure is an opaque "context deadline
# exceeded" with no detail on which stage (DNS/TCP/TLS) failed.
echo "--- Crystal reachability diagnostics ---"
getent hosts crystal.illumio.com || echo "DNS resolution FAILED for crystal.illumio.com"
# -w timings instead of -v: -v prints request headers, including the
# API key. Zero connect/tls time shows which stage failed.
curl -sS --connect-timeout 5 -m 8 -o /dev/null \
  -w "HTTP %{http_code} dns=%{time_namelookup}s connect=%{time_connect}s tls=%{time_appconnect}s\n" \
  -H "X-API-Key: $CRYSTAL_API_KEY" "$CRYSTAL_BASE_URL/api/deployments" || echo "curl exit code: $?"
echo "--- end diagnostics ---"
reach_code="$(curl -s -o /dev/null -m 8 -w "%{http_code}" -H "X-API-Key: $CRYSTAL_API_KEY" "$CRYSTAL_BASE_URL/api/deployments" || echo 000)"
[ "$reach_code" = "200" ] && echo "CHECK-OK: crystal-reachable" || echo "CHECK-FAIL: crystal-reachable (HTTP $reach_code)"

# Deployment naming: Lab_<DDMM>_<PCE org ID>_<learner>, e.g.
# Lab_3009_4140393_keith. The org ID is unique per session and
# is the same number the learner sees in their Console and the Advanced
# section, so an instructor can match a learner's lab to its Crystal
# deployment directly. <learner> is the part of the learner's email
# before the @ (Instruqt only passes it with the learner's consent),
# else the name they signed up with. Team members starting the track
# directly from the Instruqt UI get neither (seen 2026-10-01), so their
# INSTRUQT_USER_ID is looked up in the team list below; an ID not in the
# list is used as-is, and with no ID at all it's "team". Forename only
# (see below), lower-case letters and digits, max 30 characters.
# Team list from Instruqt (illumio-training team members, 2026-10-01) -
# add new team members here (name = their forename, lower case).
team_member_name() {
  case "$1" in
    6cj4yyx4rpcs) echo nathan ;;
    hzr0el9p4xq1) echo pritesh ;;
    36UKnCyZVsgasTEsujZw0yVvHr13) echo james ;;
    ltp9hziadn3q) echo keith ;;
    elqoiercnof4) echo steve ;;
    0ve5nbttzjpe) echo adrianna ;;
    1y8ce1p7yzw6) echo luca ;;
    yi944naccdvp) echo michael ;;
    I91sO8Qu7NShpx19Q0docpUbWcr1) echo harpreet ;;
    rqjmagbplzhh) echo resourcetraining ;;
  esac
}
if [ -n "${INSTRUQT_USER_EMAIL%%@*}" ]; then
  LEARNER="${INSTRUQT_USER_EMAIL%%@*}"; LEARNER_SOURCE="email"
elif [ -n "$INSTRUQT_USER_NAME" ]; then
  LEARNER="$INSTRUQT_USER_NAME"; LEARNER_SOURCE="name"
elif [ -n "$(team_member_name "$INSTRUQT_USER_ID")" ]; then
  LEARNER="$(team_member_name "$INSTRUQT_USER_ID")"; LEARNER_SOURCE="team list"
elif [ -n "$INSTRUQT_USER_ID" ]; then
  LEARNER="$INSTRUQT_USER_ID"; LEARNER_SOURCE="user ID (not in team list)"
else
  LEARNER="team"; LEARNER_SOURCE="none (no user details from Instruqt)"
fi
echo "Deployment name learner part from: $LEARNER_SOURCE"
# Forename only: everything before the first dot, space, underscore,
# dash or plus (jane.smith@... -> jane, "Jane Smith" -> jane), lower case.
LEARNER="${LEARNER%%[. _+-]*}"
LEARNER="$(printf '%s' "$LEARNER" | tr -cd 'A-Za-z0-9' | tr 'A-Z' 'a-z' | cut -c1-30)"
DEPLOYMENT_NAME="Lab_$(date -u +%d%m)_${AUTOACCOUNT_ORG_ID}${LEARNER:+_$LEARNER}"
echo "Crystal deployment name: $DEPLOYMENT_NAME"

cd ~
git clone https://github.com/justinvid/pc-connector.git
cd ~/pc-connector/
# terraform init downloads the terracurl provider from github.com, which
# has returned one-off HTTP 500s here (twice on 2026-09-30, each failing
# the whole lab setup) - retry a few times before giving up.
for i in 1 2 3; do
  terraform init && break
  if [ "$i" = "3" ]; then echo "terraform init failed 3 times - giving up"; exit 1; fi
  echo "terraform init failed (attempt $i) - retrying in 15s"
  sleep 15
done
terraform apply -auto-approve -input=false \
  -var "crystal_api_key=$CRYSTAL_API_KEY" \
  -var "crystal_base_url=$CRYSTAL_BASE_URL" \
  -var "pce_api_user=api_${AUTOACCOUNT_APIKEY_ID}" \
  -var "pce_api_secret=$AUTOACCOUNT_APIKEY_SECRET" \
  -var "org_id=$AUTOACCOUNT_ORG_ID" \
  -var "name=$DEPLOYMENT_NAME" \
  -var "template_name=$TEMPLATE_NAME" \
  -var "pce_fqdn=$pceFqdn"

CRYSTAL_DEPLOYMENT_ID="$(terraform output -raw deployment_id)"
agent variable set CRYSTALDEPLOYMENT "$CRYSTAL_DEPLOYMENT_ID"
agent variable set CRYSTALBASEURL "$CRYSTAL_BASE_URL"
[ -n "$CRYSTAL_DEPLOYMENT_ID" ] && echo "CHECK-OK: crystal-deployed ($DEPLOYMENT_NAME)" || echo "CHECK-FAIL: crystal-deployed"

# The module's own start_request fires immediately after
# template_request with no delay, but the CSV/object import behind
# the template takes a few seconds to actually finish on Crystal's
# backend - calling /start that fast returns 200 but silently doesn't
# launch anything (confirmed live: same call worked once retried a
# few minutes later). Poll status and retry /start until it's
# actually running, rather than trusting the first 200.
for i in 1 2 3 4 5 6; do
  status="$(curl -s -H "X-API-Key: $CRYSTAL_API_KEY" "$CRYSTAL_BASE_URL/api/deployments/$CRYSTAL_DEPLOYMENT_ID" | python3 -c "import json,sys; print(json.load(sys.stdin).get('status'))")"
  if [ "$status" = "running" ]; then
    echo "Crystal deployment is running (attempt $i)"
    break
  fi
  echo "Crystal deployment status is '$status' (attempt $i) - retrying /start"
  curl -s -o /dev/null -X POST -H "X-API-Key: $CRYSTAL_API_KEY" -H "Content-Type: application/json" \
    -d '{"interval":"5m","auto_attacks":false}' \
    "$CRYSTAL_BASE_URL/api/deployments/$CRYSTAL_DEPLOYMENT_ID/start"
  sleep 10
done
[ "$status" = "running" ] && echo "CHECK-OK: crystal-running" || echo "CHECK-FAIL: crystal-running (status $status)"

# Fire the Lateral Movement attack at boot so its traffic is already
# in the PCE by the time learners reach the Incident Response
# Investigation exercise, rather than relying on an instructor to hit
# Fire Attack in Crystal. Same call as the UI button. 3h is Crystal's
# default duration - the attack traffic stays in PCE traffic history
# after it ends. auto_attacks stays false on /start above so only this
# one scenario runs. The engine applies it on its next tick (up to
# ~5m), so only the HTTP response is checked here; non-2xx is retried
# and a final failure is logged, not fatal, so the rest of the lab
# still builds.
ATTACK_SCENARIO="lateralMovement_firstTimeConnection"
for i in 1 2 3 4 5 6; do
  attack_code="$(curl -s -o /tmp/crystal-attack.json -w "%{http_code}" -X POST \
    -H "X-API-Key: $CRYSTAL_API_KEY" -H "Content-Type: application/json" \
    -d "{\"scenario\":\"$ATTACK_SCENARIO\",\"duration\":\"3h\"}" \
    "$CRYSTAL_BASE_URL/api/deployments/$CRYSTAL_DEPLOYMENT_ID/attack" || echo "000")"
  if [ "${attack_code:0:1}" = "2" ]; then
    echo "Crystal attack '$ATTACK_SCENARIO' fired for 3h (attempt $i)"
    break
  fi
  echo "Crystal attack fire returned HTTP $attack_code (attempt $i): $(cat /tmp/crystal-attack.json 2>/dev/null)"
  [ "$i" = "6" ] && echo "WARNING: Lateral Movement attack NOT fired - fire it manually from Crystal"
  sleep 10
done
[ "${attack_code:0:1}" = "2" ] && echo "CHECK-OK: attack-fired" || echo "CHECK-FAIL: attack-fired (HTTP $attack_code)"

echo "--- Crystal block end ---"
set -x

nohup python3 /usr/local/bin/disable-all-rulesets > /var/log/disable-all-rulesets.log 2>&1 < /dev/null &
sleep 1
pgrep -f /usr/local/bin/disable-all-rulesets >/dev/null && echo "CHECK-OK: ruleset-job-started" || echo "CHECK-FAIL: ruleset-job-started"

echo "CHECK-OK: track-setup-complete"
echo "===== MAGIC LINK + ACCOUNT SETUP END ====="
