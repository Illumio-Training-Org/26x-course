#!/bin/sh
#
# This script runs when the platform checks the challenge.
# Exit 0 = pass, non-zero = fail.
#
# Checks the PCE's /permissions endpoint for a role assignment scoped
# to Environment=Production, Location=ca with the Ruleset Manager role,
# AND that the same user still has their default Viewer role (All scope)
# untouched alongside it - the assignment explicitly says not to remove it.
# Confirmed live 2026-08-28 against a real /permissions response:
#   [{"href":..., "role":{"href":".../roles/ruleset_manager"},
#     "scope":[{"label":{"href":...}}, {"label":{"href":...}}],
#     "auth_security_principal":{"href":...}}, ...]
# scope is a FLAT list of {"label":{"href":...}} entries (not a list
# of groups), and auth_security_principal has no "type" field.
# "Viewer" in the Console UI is role href fragment "read_only", not
# "viewer" - confirmed live 2026-09-24 against GET /orgs/{org}/roles.

# setup-cloud-client writes cleaned AUTOACCOUNT_* values here since this
# script's execution context doesn't source .bashrc (interactive-only).
. /root/.autoaccount_env

BASE="https://$AUTOACCOUNT_PCE_FQDN/api/v2/orgs/$AUTOACCOUNT_ORG_ID"
AUTH="api_${AUTOACCOUNT_APIKEY_ID}:${AUTOACCOUNT_APIKEY_SECRET}"
FQDN="$AUTOACCOUNT_PCE_FQDN"

result=$(python3 -c "
import json, subprocess, sys

def get(path):
    url = 'https://$FQDN/api/v2' + path
    out = subprocess.run(['curl', '-s', '-u', '$AUTH', url], capture_output=True, text=True).stdout
    try:
        return json.loads(out)
    except Exception:
        return None

expected_scope = {'env': 'production', 'loc': 'ca'}

perms = get('/orgs/$AUTOACCOUNT_ORG_ID/permissions')
if perms is None:
    print('No se pudo leer /permissions - crea una asignación de rol con scope para un usuario')
    sys.exit(1)

def resolve_label(href):
    lbl = get(href.replace('/api/v2', ''))
    if not lbl:
        return None
    return lbl.get('key'), (lbl.get('value') or '').lower()

too_broad = None
for p in perms:
    role_href = (p.get('role') or {}).get('href', '')
    if 'ruleset_manager' not in role_href:
        continue
    scope = p.get('scope') or []
    if not scope:
        continue  # empty scope = org-wide, not what we want
    matched = {}
    for entry in scope:
        href = (entry.get('label') or {}).get('href')
        if not href:
            continue
        kv = resolve_label(href)
        if kv:
            matched[kv[0]] = kv[1]
    if matched == expected_scope:
        principal_href = (p.get('auth_security_principal') or {}).get('href')
        has_viewer = False
        for v in perms:
            v_role_href = (v.get('role') or {}).get('href', '')
            if 'read_only' not in v_role_href:
                continue
            v_principal_href = (v.get('auth_security_principal') or {}).get('href')
            if v_principal_href != principal_href:
                continue
            if not (v.get('scope') or []):
                has_viewer = True
                break
        if not has_viewer:
            print('Se encontró el rol Ruleset Manager con scope, pero el mismo usuario ya no tiene su rol Viewer predeterminado con scope All - debe mantenerse junto al nuevo rol')
            sys.exit(1)
        print('Se encontró un usuario con Ruleset Manager limitado exactamente a Environment=Production, Location=ca, y el rol Viewer predeterminado (scope All) sigue en su lugar')
        sys.exit(0)
    if all(matched.get(k) == v for k, v in expected_scope.items()):
        too_broad = sorted(matched.keys())

if too_broad:
    print('El scope tiene labels adicionales además de Environment=Production, Location=ca - limítalo solo a esas 2, se encontró: ' + str(too_broad))
else:
    print('No se encontró ningún usuario con el rol Ruleset Manager limitado específicamente a Environment=Production, Location=ca')
sys.exit(1)
")
status=$?
if [ "$status" -ne 0 ]; then
  fail-message "$result"
  exit 1
fi
echo "$result"
exit 0
