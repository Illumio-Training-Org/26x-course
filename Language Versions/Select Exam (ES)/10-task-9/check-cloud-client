#!/bin/sh
#
# This script runs when the platform checks the challenge.
# Exit 0 = pass, non-zero = fail.
#
# Scopes aren't taught in this course, so this task does NOT accept a
# Scope-based ruleset - it requires two plain rules: the intra-Payment
# ringfence (Application=payment, Location=ldn repeated on both source
# and destination) and the inbound Ordering->Payment/LDN rule on
# TCP/443 (HTTPS).
#
# Fixed 2026-09-11: the inbound rule's source only checked that
# Application=ordering was present (extras allowed) and its
# destination used a subset check (extras allowed there too) -
# live-caught by Nathan, who wants no other labels on either side.
# Both now require an exact label match, same as the ringfence rule
# already did. Confirmed the service check already accepts either a
# named HTTPS service or a raw TCP/443 entry - either is correct.

. /root/.autoaccount_env

BASE="https://$AUTOACCOUNT_PCE_FQDN/api/v2/orgs/$AUTOACCOUNT_ORG_ID"
AUTH="api_${AUTOACCOUNT_APIKEY_ID}:${AUTOACCOUNT_APIKEY_SECRET}"
FQDN="$AUTOACCOUNT_PCE_FQDN"

result=$(python3 -c "
import json, subprocess, sys

def get(path):
    url = 'https://$FQDN/api/v2' + path
    out = subprocess.run(['curl', '-s', '-u', '$AUTH', url], capture_output=True, text=True).stdout
    return json.loads(out)

rulesets = get('/orgs/$AUTOACCOUNT_ORG_ID/sec_policy/draft/rule_sets')
rs = next((r for r in rulesets if (r.get('name') or '').lower() == 'task9-ringfencepayment'), None)
if not rs:
    print('No se encontró la Policy \"Task9-RingfencePayment\"')
    sys.exit(1)

for scope in rs.get('scopes', []):
    if scope:
        print('Task9-RingfencePayment no debe usar un Scope - crea la regla de ringfencing con Application=payment, Location=ldn tanto en el Source como en el Destination')
        sys.exit(1)

def resolve_labels(entries):
    out = set()
    for e in entries:
        href = (e.get('label') or {}).get('href')
        if href:
            lbl = get(href.replace('/api/v2', ''))
            out.add(((lbl.get('key') or '').lower(), (lbl.get('value') or '').lower()))
    return out

expected = {('app', 'payment'), ('loc', 'ldn')}

def is_all_services(ingress_services):
    if not ingress_services:
        return True
    for entry in ingress_services:
        href = entry.get('href')
        if href:
            svc = get(href.replace('/api/v2', ''))
            if (svc.get('name') or '').lower() == 'all services':
                return True
    return False

def has_tcp_443(ingress_services):
    for entry in ingress_services or []:
        if entry.get('port') == 443 and entry.get('proto') == 6:
            return True
        href = entry.get('href')
        if href:
            svc = get(href.replace('/api/v2', ''))
            for sp in svc.get('service_ports', []):
                if sp.get('port') == 443 and sp.get('proto') == 6:
                    return True
    return False

enabled_rules = [rule for rule in rs.get('rules', []) if rule.get('enabled', True)]
if len(enabled_rules) != 2:
    print('Task9-RingfencePayment debe tener exactamente dos reglas habilitadas (la regla allow de ringfencing y la regla entrante ordering->payment), se encontraron ' + str(len(enabled_rules)))
    sys.exit(1)

ringfence_rule = next((r for r in enabled_rules if is_all_services(r.get('ingress_services'))), None)
inbound_rule = next((r for r in enabled_rules if has_tcp_443(r.get('ingress_services'))), None)

reasons = []

if not ringfence_rule:
    reasons.append('falta la regla de ringfencing interna de payment para All Services')
else:
    src_ok = resolve_labels(ringfence_rule.get('consumers', [])) == expected
    dst_ok = resolve_labels(ringfence_rule.get('providers', [])) == expected
    if not src_ok:
        reasons.append('el Source de la regla de ringfencing es incorrecto - debe ser Application=payment, Location=ldn')
    if not dst_ok:
        reasons.append('el Destination de la regla de ringfencing es incorrecto - debe ser Application=payment, Location=ldn')

if not inbound_rule:
    reasons.append('falta la regla allow entrante ordering -> payment en TCP/443 (HTTPS)')
else:
    consumer_labels = resolve_labels(inbound_rule.get('consumers', []))
    if consumer_labels != {('app', 'ordering')}:
        reasons.append('el Source de la regla entrante es incorrecto - debe ser exactamente Application=ordering, sin otras labels, se encontró ' + str(sorted(consumer_labels)))
    provider_labels = resolve_labels(inbound_rule.get('providers', []))
    if provider_labels != expected:
        reasons.append('el Destination de la regla entrante es incorrecto - debe ser exactamente Application=payment, Location=ldn, sin otras labels, se encontró ' + str(sorted(provider_labels)))

if reasons:
    print('; '.join(reasons))
    sys.exit(1)

print('Task9-RingfencePayment aplica ringfencing a payment/ldn y permite HTTPS entrante desde ordering')
sys.exit(0)
")
status=$?
if [ "$status" -ne 0 ]; then
  fail-message "$result"
  exit 1
fi
echo "$result"
exit 0
