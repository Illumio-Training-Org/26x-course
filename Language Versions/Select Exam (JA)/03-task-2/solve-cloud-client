#!/bin/sh
#
# Runs when the learner clicks Skip. Corrects the FULL expected label
# set (role, app, env, loc, type, DFIRBubble) on both workloads -
# overwriting any wrong/missing value for those 6 keys rather than
# just appending the 2 new ones - since a learner who paired the VENs
# without the right Role label (or any of the other 4 base labels)
# would otherwise be left in a state check-cloud-client can never
# pass even after Skip. Any other, unrelated label on the workload is
# left untouched. Also creates Task2-Ringfence as a scopeless ruleset
# with an allow rule that has all 5 labels on both source and
# destination - Scopes aren't taught in this course and
# check-cloud-client does not accept a Scope-based equivalent.
# NOT YET LIVE-VERIFIED against a real sandbox.

. /root/.autoaccount_env

AUTH="api_${AUTOACCOUNT_APIKEY_ID}:${AUTOACCOUNT_APIKEY_SECRET}"
FQDN="$AUTOACCOUNT_PCE_FQDN"

python3 -c "
import json, subprocess

def call(method, path, body=None):
    cmd = ['curl', '-s', '-u', '$AUTH', '-X', method, 'https://$FQDN/api/v2' + path]
    if body is not None:
        cmd += ['-H', 'Content-Type: application/json', '-d', json.dumps(body)]
    out = subprocess.run(cmd, capture_output=True, text=True).stdout
    try:
        return json.loads(out)
    except Exception:
        return None

def find_or_create_label(key, value):
    labels = call('GET', '/orgs/$AUTOACCOUNT_ORG_ID/labels?max_results=1000') or []
    for l in labels:
        if l.get('key') == key and (l.get('value') or '').lower() == value.lower():
            return l['href']
    created = call('POST', '/orgs/$AUTOACCOUNT_ORG_ID/labels', {'key': key, 'value': value})
    return created['href'] if created else None

def find_all_services_href():
    services = call('GET', '/orgs/$AUTOACCOUNT_ORG_ID/sec_policy/draft/services?max_results=1000') or []
    for s in services:
        if (s.get('name') or '').lower() == 'all services':
            return s['href']
    return None

type_href = find_or_create_label('type', 'server')
ir_href = find_or_create_label('DFIRBubble', 'IR-CLEANBUBBLE')
app_href_shared = find_or_create_label('app', 'portal')
env_href_shared = find_or_create_label('env', 'Production')
loc_href_shared = find_or_create_label('loc', 'ca')
role_href_by_host = {
    'linux-vm': find_or_create_label('role', 'web'),
    'windows-vm': find_or_create_label('role', 'db'),
}
expected_hrefs_by_host = {
    host: {'role': role_href_by_host[host], 'app': app_href_shared, 'env': env_href_shared, 'loc': loc_href_shared, 'type': type_href, 'dfirbubble': ir_href}
    for host in ('linux-vm', 'windows-vm')
}

ws = call('GET', '/orgs/$AUTOACCOUNT_ORG_ID/workloads?max_results=1000') or []
by_host = {w.get('hostname'): w for w in ws}
label_cache = {}
for host in ('linux-vm', 'windows-vm'):
    wl = by_host.get(host)
    if not wl:
        continue
    expected = expected_hrefs_by_host[host]
    kept = []
    for l in wl.get('labels', []):
        href = l.get('href')
        if not href:
            continue
        if href not in label_cache:
            label_cache[href] = call('GET', href.replace('/api/v2', '')) or {}
        key = (label_cache[href].get('key') or '').lower()
        if key not in expected:
            kept.append({'href': href})
    call('PUT', wl['href'], {'labels': kept + [{'href': h} for h in expected.values() if h]})

app_href = app_href_shared
env_href = env_href_shared
loc_href = loc_href_shared
all_services_href = find_all_services_href()

rulesets = call('GET', '/orgs/$AUTOACCOUNT_ORG_ID/sec_policy/draft/rule_sets?max_results=1000') or []
rs = next((r for r in rulesets if (r.get('name') or '').lower() == 'task2-ringfence'), None)
if not rs:
    rs = call('POST', '/orgs/$AUTOACCOUNT_ORG_ID/sec_policy/draft/rule_sets', {
        'name': 'Task2-Ringfence',
        'scopes': [[]],
    })

if rs and rs.get('href'):
    existing_rules = rs.get('rules', [])
    if not any(rule.get('enabled', True) for rule in existing_rules):
        entries = [
            {'label': {'href': app_href}},
            {'label': {'href': env_href}},
            {'label': {'href': loc_href}},
            {'label': {'href': type_href}},
            {'label': {'href': ir_href}},
        ]
        call('POST', rs['href'] + '/sec_rules', {
            'enabled': True,
            'providers': entries,
            'consumers': entries,
            'ingress_services': [{'href': all_services_href}] if all_services_href else [],
            'resolve_labels_as': {'providers': ['workloads'], 'consumers': ['workloads']},
        })
"

exit 0
