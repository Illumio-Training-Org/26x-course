#!/bin/bash
#
# Used by `instruqt track test`: records the expected policy so the check
# passes, keeping any workloads already recorded.
python3 - <<'PY'
import json
f = '/root/pce-lab-state.json'
try:
    d = json.load(open(f))
except Exception:
    d = {'workloads': []}
d['policies'] = [{'name': 'Block Development to Production', 'rules': [{'type': 'allow', 'enabled': True,
                  'sources': ['env:Development'], 'destinations': ['env:Production'], 'services': ['All Services']}]}]
json.dump(d, open(f, 'w'))
PY
