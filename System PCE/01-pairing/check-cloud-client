#!/bin/bash
#
# Passes when linux-ven-01, windows-ven-01 and aix-ven-01 are all paired.
# The Console/terminal pages report the paired workloads to the lab web
# server (/opt/pce-lab/server.py), which writes /root/pce-lab-state.json.

STATE=/root/pce-lab-state.json

result=$(python3 - "$STATE" <<'PY'
import json, sys
names = {'linux': 'Linux (linux-ven-01)', 'windows': 'Windows (windows-ven-01)', 'aix': 'AIX (aix-ven-01)'}
try:
    paired = set(json.load(open(sys.argv[1])).get('workloads', []))
except Exception:
    paired = set()
missing = [names[k] for k in ('linux', 'windows', 'aix') if k not in paired]
if missing:
    print('Not all workloads are paired yet. Still to pair: ' + ', '.join(missing) + '.')
    sys.exit(1)
print('All three workloads are paired: linux-ven-01, windows-ven-01 and aix-ven-01.')
PY
)
status=$?
if [ "$status" -ne 0 ]; then
  fail-message "$result"
  exit 1
fi
echo "$result"
exit 0
