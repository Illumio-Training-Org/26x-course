#!/bin/bash
#
# Used by `instruqt track test`: records the expected objects so the check
# passes, keeping anything already recorded.
python3 - <<'PY'
import json
f = '/root/pce-lab-state.json'
try:
    d = json.load(open(f))
except Exception:
    d = {'workloads': []}
labels = [l for l in d.get('labels', []) if l.get('value', '').lower() not in ('inventory', 'qa', 'de')]
d['labels'] = labels + [{'key': 'app', 'value': 'inventory'}, {'key': 'env', 'value': 'QA'}, {'key': 'loc', 'value': 'de'}]
json.dump(d, open(f, 'w'))
PY
