#!/bin/bash
#
# Used by `instruqt track test`: records the expected objects so the check
# passes, keeping anything already recorded.
python3 - <<'PY'
import json
f = '/root/pce-lab-state.json'
try:
    d = json.load(open(f))
except Exception:
    d = {'workloads': []}
services = [s for s in d.get('services', []) if s.get('name', '').lower() != 'elasticsearch']
d['services'] = services + [{'name': 'Elasticsearch', 'ports': '9200 TCP, 9300 TCP'}]
json.dump(d, open(f, 'w'))
PY
