#!/bin/sh
set -e

# Force AWS region
export AWS_REGION=us-east-1
export AWS_DEFAULT_REGION=us-east-1

cd /root

# Idempotent: if this script re-runs (e.g. a challenge restart/retry),
# reuse the existing clone/state instead of failing silently on a
# duplicate clone and risking a second, un-reconciled terraform apply.
if [ -d 26x-course/.git ]; then
  cd 26x-course && git pull --ff-only
else
  rm -rf 26x-course
  git clone https://github.com/Illumio-Training-Org/26x-course.git
  cd 26x-course
fi
cd /root/26x-course/terraform

# Install Terraform only if it isn't already present (idempotent re-run)
if ! command -v terraform >/dev/null 2>&1; then
  # Add HashiCorp GPG key
  curl -fsSL https://apt.releases.hashicorp.com/gpg | gpg --yes --dearmor -o /usr/share/keyrings/hashicorp-archive-keyring.gpg

  # Add HashiCorp apt repo
  echo "deb [signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com $(lsb_release -cs) main" > /etc/apt/sources.list.d/hashicorp.list

  # Update ONLY HashiCorp repo to speed it up
  apt-get update -o Dir::Etc::sourcelist="sources.list.d/hashicorp.list" \
                 -o Dir::Etc::sourceparts="-" \
                 -o APT::Get::List-Cleanup="0"

  # Install Terraform
  apt-get install -y terraform
fi

# Configure Terraform - reconciles with existing state if this is a
# re-run, rather than creating a second, un-tracked set of resources
terraform init -input=false
terraform plan -out=tfplan -input=false
terraform apply -input=false -auto-approve tfplan

# Configure SSH
cp my-keypair.pem /root/.ssh/
