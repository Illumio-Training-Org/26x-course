#!/bin/sh
set -ex

echo "===== k3s/Cilium bootstrap START ====="

# Deploy Cilium as the CNI (image ships the binary, but install still has
# to run against this specific cluster instance). Firewall coexistence is
# deliberately NOT configured here - that's a hands-on learner task in
# Challenge 4 (checking status and configuring coexistence themselves).
cilium install
cilium hubble enable

# Shorthand for the learner's console
echo "alias k=kubectl" >> /root/.bashrc

echo "===== k3s/Cilium bootstrap END ====="
